---
/**
 * SEO Component for Alpha Sign AG
 * Handles meta tags, Open Graph, and Twitter Cards
 * Optimized for Swiss local SEO
 */

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'product';
  locale?: string;
  noindex?: boolean;
  nofollow?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  keywords?: string[];
}

const {
  title,
  description,
  canonical = Astro.url.href,
  image = '/og-image.jpg',
  imageAlt = 'Alpha Sign AG - Schilder und Beschriftungen',
  type = 'website',
  locale = 'de-CH',
  noindex = false,
  nofollow = false,
  publishedTime,
  modifiedTime,
  author,
  keywords = [],
} = Astro.props;

// Company constants
const siteName = 'Alpha Sign AG';
const twitterHandle = '@alphasignag';

// Build full image URL
const imageUrl = new URL(image, Astro.site || Astro.url.origin).href;

// Build robots meta content
const robotsContent = [
  noindex ? 'noindex' : 'index',
  nofollow ? 'nofollow' : 'follow',
  'max-image-preview:large',
  'max-snippet:-1',
  'max-video-preview:-1',
].join(', ');

// Supported locales for Swiss market
const alternateLocales = ['de-CH', 'fr-CH', 'it-CH', 'en'];
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
<meta name="author" content={author || siteName} />
<meta name="robots" content={robotsContent} />
<meta name="googlebot" content={robotsContent} />

<!-- Canonical URL -->
<link rel="canonical" href={canonical} />

<!-- Language and Region Tags for Swiss Market -->
<meta name="geo.region" content="CH-ZG" />
<meta name="geo.placename" content="Hünenberg" />
<meta name="geo.position" content="47.1756;8.4267" />
<meta name="ICBM" content="47.1756, 8.4267" />
<meta name="language" content={locale.split('-')[0]} />
<meta name="content-language" content={locale} />

<!-- Alternate Language Links -->
{alternateLocales.map((lang) => (
  <link
    rel="alternate"
    hreflang={lang}
    href={canonical.replace(/\/(de|fr|it|en)\//, `/${lang.split('-')[0]}/`)}
  />
))}
<link rel="alternate" hreflang="x-default" href={canonical} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={locale.replace('-', '_')} />
{alternateLocales.filter(l => l !== locale).map((lang) => (
  <meta property="og:locale:alternate" content={lang.replace('-', '_')} />
))}

<!-- Article specific Open Graph tags -->
{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{type === 'article' && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime} />
)}
{type === 'article' && author && (
  <meta property="article:author" content={author} />
)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonical} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
<meta name="twitter:site" content={twitterHandle} />
<meta name="twitter:creator" content={twitterHandle} />

<!-- Additional SEO Tags -->
<meta name="format-detection" content="telephone=yes" />
<meta name="theme-color" content="#1a365d" />
<meta name="msapplication-TileColor" content="#1a365d" />
