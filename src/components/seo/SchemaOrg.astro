---
/**
 * Schema.org JSON-LD Structured Data Component
 * Supports multiple schema types for comprehensive SEO:
 * - LocalBusiness (for all pages)
 * - Service (for service pages)
 * - FAQPage (for FAQ sections)
 * - HowTo (for process steps)
 * - Product (for services with pricing)
 * - Review/AggregateRating
 * - BreadcrumbList
 * - Organization
 * - ContactPoint
 *
 * Optimized for Swiss local SEO
 */

export interface LocalBusinessSchema {
  type: 'LocalBusiness';
  additionalType?: string;
}

export interface OrganizationSchema {
  type: 'Organization';
}

export interface ServiceSchema {
  type: 'Service';
  name: string;
  description: string;
  serviceType?: string;
  areaServed?: string[];
  image?: string;
  url?: string;
  offers?: {
    price?: string;
    priceCurrency?: string;
    priceValidUntil?: string;
    lowPrice?: string;
    highPrice?: string;
  };
}

export interface ProductSchema {
  type: 'Product';
  name: string;
  description: string;
  image?: string;
  brand?: string;
  sku?: string;
  offers?: {
    lowPrice: string;
    highPrice: string;
    priceCurrency?: string;
    priceValidUntil?: string;
  };
}

export interface FAQSchema {
  type: 'FAQPage';
  questions: Array<{
    question: string;
    answer: string;
  }>;
}

export interface HowToSchema {
  type: 'HowTo';
  name: string;
  description?: string;
  image?: string;
  totalTime?: string;
  estimatedCost?: {
    currency: string;
    minValue: string;
    maxValue: string;
  };
  steps: Array<{
    name: string;
    text: string;
    image?: string;
    url?: string;
  }>;
}

export interface ReviewSchema {
  type: 'Review';
  author: string;
  reviewRating: {
    ratingValue: string;
    bestRating?: string;
    worstRating?: string;
  };
  reviewBody: string;
  datePublished?: string;
}

export interface AggregateRatingSchema {
  type: 'AggregateRating';
  ratingValue: string;
  reviewCount: string;
  bestRating?: string;
  worstRating?: string;
}

export interface BreadcrumbSchema {
  type: 'BreadcrumbList';
  items: Array<{
    name: string;
    url: string;
  }>;
}

export interface ContactPointSchema {
  type: 'ContactPoint';
  telephone?: string;
  email?: string;
  contactType: string;
  areaServed?: string[];
  availableLanguage?: string[];
}

type SchemaType =
  | LocalBusinessSchema
  | OrganizationSchema
  | ServiceSchema
  | ProductSchema
  | FAQSchema
  | HowToSchema
  | ReviewSchema
  | AggregateRatingSchema
  | BreadcrumbSchema
  | ContactPointSchema;

interface Props {
  schema: SchemaType | SchemaType[];
}

const { schema } = Astro.props;

