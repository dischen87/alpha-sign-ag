function buildLocalBusinessSchema(data: LocalBusinessSchema) {
  // Use array of types if additionalType is provided for proper schema.org format
  const schemaType = data.additionalType 
    ? ['LocalBusiness', data.additionalType] 
    : 'LocalBusiness';
  
  return {
    '@context': 'https://schema.org',
    '@type': schemaType,
    '@id': `${company.url}#organization`,
    name: company.name,
    legalName: company.legalName,
    url: company.url,
    logo: {
      '@type': 'ImageObject',
      url: company.logo,
      width: 600,
      height: 60,
