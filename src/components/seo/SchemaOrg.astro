function buildOrganizationSchema(_data: OrganizationSchema) {
  return {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${company.url}#organization`,
    name: company.name,
    legalName: company.legalName,
    url: company.url,
    logo: {
      '@type': 'ImageObject',
      url: company.logo,
      width: 600,
      height: 60,
    },
    image: company.image,
    description: company.description,
    foundingDate: company.foundingDate,
    address: company.address,
    telephone: company.telephone,
    email: company.email,
    sameAs: company.sameAs,
    contactPoint: company.contactPoint,
    areaServed: company.areaServed,
  };
}

function buildServiceSchema(data: ServiceSchema) {
  const serviceSlug = data.name.toLowerCase()
    .replace(/\s+/g, '-')
    .replace(/[äöü]/g, (char) => ({ 'ä': 'ae', 'ö': 'oe', 'ü': 'ue' }[char] || char));

  return {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': data.url || `${company.url}/dienstleistungen/${serviceSlug}#service`,
    name: data.name,
    description: data.description,
    serviceType: data.serviceType || data.name,
    image: data.image,
    provider: {
      '@type': 'LocalBusiness',
      '@id': `${company.url}#organization`,
      name: company.name,
      telephone: company.telephone,
      email: company.email,
      address: company.address,
      geo: company.geo,
      aggregateRating: company.aggregateRating,
    },
    areaServed: data.areaServed?.map((area) => ({
      '@type': 'AdministrativeArea',
      name: area,
    })) || {
      '@type': 'Country',
      name: 'Switzerland',
    },
    ...(data.offers && {
      offers: {
        '@type': 'AggregateOffer',
        lowPrice: data.offers.lowPrice || data.offers.price,
        highPrice: data.offers.highPrice,
        priceCurrency: data.offers.priceCurrency || 'CHF',
        priceValidUntil: data.offers.priceValidUntil || '2026-12-31',
        availability: 'https://schema.org/InStock',
        seller: {
          '@type': 'LocalBusiness',
          '@id': `${company.url}#organization`,
          name: company.name,
        },
      },
    }),
    termsOfService: `${company.url}/agb`,
    brand: {
      '@type': 'Brand',
      name: company.name,
    },
  };
}

function buildProductSchema(data: ProductSchema) {
  return {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: data.name,
    description: data.description,
    image: data.image,
    brand: {
      '@type': 'Brand',
      name: data.brand || company.name,
    },
    ...(data.sku && { sku: data.sku }),
    aggregateRating: company.aggregateRating,
    ...(data.offers && {
      offers: {
        '@type': 'AggregateOffer',
        lowPrice: data.offers.lowPrice,
        highPrice: data.offers.highPrice,
        priceCurrency: data.offers.priceCurrency || 'CHF',
        priceValidUntil: data.offers.priceValidUntil || '2026-12-31',
        availability: 'https://schema.org/InStock',
        seller: {
          '@type': 'LocalBusiness',
          '@id': `${company.url}#organization`,
          name: company.name,
        },
      },
    }),
  };
}

function buildFAQSchema(data: FAQSchema) {
  return {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: data.questions.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  };
}

function buildHowToSchema(data: HowToSchema) {
  return {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: data.name,
    description: data.description,
    ...(data.image && { image: data.image }),
    ...(data.totalTime && { totalTime: data.totalTime }),
    ...(data.estimatedCost && {
      estimatedCost: {
        '@type': 'MonetaryAmountDistribution',
        currency: data.estimatedCost.currency,
        minValue: data.estimatedCost.minValue,
        maxValue: data.estimatedCost.maxValue,
      },
    }),
    step: data.steps.map((step, index) => ({
      '@type': 'HowToStep',
      position: index + 1,
      name: step.name,
      text: step.text,
      ...(step.image && { image: step.image }),
      ...(step.url && { url: step.url }),
    })),
  };
}

function buildReviewSchema(data: ReviewSchema) {
  return {
    '@context': 'https://schema.org',
    '@type': 'Review',
    itemReviewed: {
      '@type': 'LocalBusiness',
      '@id': `${company.url}#organization`,
      name: company.name,
    },
    author: {
      '@type': 'Person',
      name: data.author,
    },
    reviewRating: {
      '@type': 'Rating',
      ratingValue: data.reviewRating.ratingValue,
      bestRating: data.reviewRating.bestRating || '5',
      worstRating: data.reviewRating.worstRating || '1',
    },
    reviewBody: data.reviewBody,
    ...(data.datePublished && { datePublished: data.datePublished }),
  };
}

function buildAggregateRatingSchema(data: AggregateRatingSchema) {
  return {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    '@id': `${company.url}#organization`,
    name: company.name,
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: data.ratingValue,
      reviewCount: data.reviewCount,
      bestRating: data.bestRating || '5',
      worstRating: data.worstRating || '1',
    },
  };
}

function buildBreadcrumbSchema(data: BreadcrumbSchema) {
  return {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: data.items.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.name,
      item: item.url,
    })),
  };
}

function buildContactPointSchema(data: ContactPointSchema) {
  return {
    '@context': 'https://schema.org',
    '@type': 'ContactPoint',
    ...(data.telephone && { telephone: data.telephone }),
    ...(data.email && { email: data.email }),
    contactType: data.contactType,
    ...(data.areaServed && { areaServed: data.areaServed }),
    ...(data.availableLanguage && { availableLanguage: data.availableLanguage }),
  };
}

function buildSchema(schemaData: SchemaType) {
  switch (schemaData.type) {
    case 'LocalBusiness':
      return buildLocalBusinessSchema(schemaData);
    case 'Organization':
      return buildOrganizationSchema(schemaData);
    case 'Service':
      return buildServiceSchema(schemaData);
    case 'Product':
      return buildProductSchema(schemaData);
    case 'FAQPage':
      return buildFAQSchema(schemaData);
    case 'HowTo':
      return buildHowToSchema(schemaData);
    case 'Review':
      return buildReviewSchema(schemaData);
    case 'AggregateRating':
      return buildAggregateRatingSchema(schemaData);
    case 'BreadcrumbList':
      return buildBreadcrumbSchema(schemaData);
    case 'ContactPoint':
      return buildContactPointSchema(schemaData);
    default:
      return null;
  }
}

const schemas = Array.isArray(schema) ? schema : [schema];
const jsonLdScripts = schemas.map(buildSchema).filter(Boolean);
---

{jsonLdScripts.map((jsonLd) => (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
))}
