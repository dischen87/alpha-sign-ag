---
/**
 * AnimateOnScroll Component
 * A reusable component that animates its children when they enter the viewport
 * Uses IntersectionObserver for performance
 * Respects prefers-reduced-motion
 */
interface Props {
  /** Animation type */
  animation?: 'fade-up' | 'fade-in' | 'slide-from-left' | 'slide-from-right' | 'scale-up' | 'fade-down';
  /** Delay in milliseconds before animation starts */
  delay?: number;
  /** Duration of the animation in milliseconds */
  duration?: number;
  /** Threshold for IntersectionObserver (0-1) */
  threshold?: number;
  /** Whether to animate only once or every time element enters viewport */
  once?: boolean;
  /** Additional CSS classes */
  class?: string;
  /** HTML tag to render */
  as?: 'div' | 'section' | 'article' | 'span' | 'li' | 'ul' | 'p' | 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
  /** Stagger delay for children (used with data-stagger-index) */
  staggerDelay?: number;
}

const {
  animation = 'fade-up',
  delay = 0,
  duration = 600,
  threshold = 0.15,
  once = true,
  class: className = '',
  as: Tag = 'div',
  staggerDelay = 0,
} = Astro.props;

const animationClass = `animate-on-scroll animate-${animation}`;
---

<Tag
  class:list={[animationClass, className]}
  data-animation={animation}
  data-delay={delay}
  data-duration={duration}
  data-threshold={threshold}
  data-once={once}
  data-stagger-delay={staggerDelay}
>
  <slot />
</Tag>

<style is:global>
  /* Base state for all animate-on-scroll elements */
  .animate-on-scroll {
    opacity: 0;
    will-change: transform, opacity;
  }

  /* Visible state - applied when element enters viewport */
  .animate-on-scroll.is-visible {
    opacity: 1;
  }

  /* Animation: Fade Up */
  .animate-fade-up {
    transform: translateY(30px);
    transition: opacity var(--animation-duration, 0.6s) cubic-bezier(0.25, 0.1, 0.25, 1),
                transform var(--animation-duration, 0.6s) cubic-bezier(0.25, 0.1, 0.25, 1);
    transition-delay: var(--animation-delay, 0s);
  }
  .animate-fade-up.is-visible {
    transform: translateY(0);
  }

  /* Animation: Fade Down */
  .animate-fade-down {
    transform: translateY(-30px);
    transition: opacity var(--animation-duration, 0.6s) cubic-bezier(0.25, 0.1, 0.25, 1),
                transform var(--animation-duration, 0.6s) cubic-bezier(0.25, 0.1, 0.25, 1);
    transition-delay: var(--animation-delay, 0s);
  }
  .animate-fade-down.is-visible {
    transform: translateY(0);
  }

  /* Animation: Fade In */
  .animate-fade-in {
    transition: opacity var(--animation-duration, 0.6s) cubic-bezier(0.25, 0.1, 0.25, 1);
    transition-delay: var(--animation-delay, 0s);
  }

  /* Animation: Slide From Left */
  .animate-slide-from-left {
    transform: translateX(-50px);
    transition: opacity var(--animation-duration, 0.6s) cubic-bezier(0.25, 0.1, 0.25, 1),
                transform var(--animation-duration, 0.6s) cubic-bezier(0.25, 0.1, 0.25, 1);
    transition-delay: var(--animation-delay, 0s);
  }
  .animate-slide-from-left.is-visible {
    transform: translateX(0);
  }

  /* Animation: Slide From Right */
  .animate-slide-from-right {
    transform: translateX(50px);
    transition: opacity var(--animation-duration, 0.6s) cubic-bezier(0.25, 0.1, 0.25, 1),
                transform var(--animation-duration, 0.6s) cubic-bezier(0.25, 0.1, 0.25, 1);
    transition-delay: var(--animation-delay, 0s);
  }
  .animate-slide-from-right.is-visible {
    transform: translateX(0);
  }

  /* Animation: Scale Up */
  .animate-scale-up {
    transform: scale(0.9);
    transition: opacity var(--animation-duration, 0.6s) cubic-bezier(0.25, 0.1, 0.25, 1),
                transform var(--animation-duration, 0.6s) cubic-bezier(0.34, 1.56, 0.64, 1);
    transition-delay: var(--animation-delay, 0s);
  }
  .animate-scale-up.is-visible {
    transform: scale(1);
  }

  /* Respect reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    .animate-on-scroll {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    .animate-on-scroll.is-visible {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  // Animation observer for scroll-triggered animations
  function initAnimateOnScroll() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // If user prefers reduced motion, make all elements visible immediately
    if (prefersReducedMotion) {
      document.querySelectorAll('.animate-on-scroll').forEach(el => {
        el.classList.add('is-visible');
      });
      return;
    }

    const animatedElements = document.querySelectorAll<HTMLElement>('.animate-on-scroll');

    if (animatedElements.length === 0) return;

    // Create observers grouped by threshold
    const observersByThreshold = new Map<number, IntersectionObserver>();

    animatedElements.forEach((element) => {
      // Get animation parameters from data attributes
      const delay = parseInt(element.dataset.delay || '0', 10);
      const duration = parseInt(element.dataset.duration || '600', 10);
      const threshold = parseFloat(element.dataset.threshold || '0.15');
      const once = element.dataset.once !== 'false';
      const staggerDelay = parseInt(element.dataset.staggerDelay || '0', 10);

      // Apply custom CSS properties for timing
      element.style.setProperty('--animation-delay', `${delay}ms`);
      element.style.setProperty('--animation-duration', `${duration}ms`);

      // Handle staggered children
      if (staggerDelay > 0) {
        const children = element.querySelectorAll('[data-stagger-index]');
        children.forEach((child) => {
          const index = parseInt((child as HTMLElement).dataset.staggerIndex || '0', 10);
          (child as HTMLElement).style.setProperty('--animation-delay', `${delay + (index * staggerDelay)}ms`);
        });
      }

      // Get or create observer for this threshold
      if (!observersByThreshold.has(threshold)) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const target = entry.target as HTMLElement;
                target.classList.add('is-visible');

                // If once is true, stop observing after animation
                if (target.dataset.once !== 'false') {
                  observer.unobserve(target);
                }
              } else {
                // If not once, remove visible class when out of view
                const target = entry.target as HTMLElement;
                if (target.dataset.once === 'false') {
                  target.classList.remove('is-visible');
                }
              }
            });
          },
          {
            threshold,
            rootMargin: '0px 0px -50px 0px',
          }
        );
        observersByThreshold.set(threshold, observer);
      }

      // Start observing the element
      observersByThreshold.get(threshold)?.observe(element);
    });
  }

  // Initialize on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAnimateOnScroll);
  } else {
    initAnimateOnScroll();
  }

  // Re-initialize on Astro page transitions (if using View Transitions)
  document.addEventListener('astro:page-load', initAnimateOnScroll);
</script>
