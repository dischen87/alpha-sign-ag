---
/**
 * Spinner Component
 * Loading indicator with multiple styles and sizes.
 */
interface Props {
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  variant?: 'default' | 'dots' | 'pulse' | 'bars';
  color?: 'primary' | 'secondary' | 'white' | 'current';
  label?: string;
  class?: string;
}

const {
  size = 'md',
  variant = 'default',
  color = 'primary',
  label = 'Loading...',
  class: className = '',
} = Astro.props;

const sizeStyles = {
  xs: 'w-4 h-4',
  sm: 'w-5 h-5',
  md: 'w-8 h-8',
  lg: 'w-12 h-12',
  xl: 'w-16 h-16',
};

const colorStyles = {
  primary: 'text-[rgb(var(--color-primary))]',
  secondary: 'text-[rgb(var(--color-secondary))]',
  white: 'text-white',
  current: 'text-current',
};

const dotSizes = {
  xs: 'w-1 h-1',
  sm: 'w-1.5 h-1.5',
  md: 'w-2 h-2',
  lg: 'w-3 h-3',
  xl: 'w-4 h-4',
};

const barSizes = {
  xs: 'w-0.5 h-3',
  sm: 'w-1 h-4',
  md: 'w-1.5 h-6',
  lg: 'w-2 h-8',
  xl: 'w-2.5 h-10',
};
---

<div
  role="status"
  aria-label={label}
  class={`inline-flex items-center justify-center ${className}`}
>
  {variant === 'default' && (
    <svg
      class={`animate-spin ${sizeStyles[size]} ${colorStyles[color]}`}
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <circle
        class="opacity-25"
        cx="12"
        cy="12"
        r="10"
        stroke="currentColor"
        stroke-width="4"
      />
      <path
        class="opacity-75"
        fill="currentColor"
        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
      />
    </svg>
  )}

  {variant === 'dots' && (
    <div class={`flex gap-1 ${colorStyles[color]}`}>
      <div class={`${dotSizes[size]} rounded-full bg-current animate-bounce`} style="animation-delay: 0ms;"></div>
      <div class={`${dotSizes[size]} rounded-full bg-current animate-bounce`} style="animation-delay: 150ms;"></div>
      <div class={`${dotSizes[size]} rounded-full bg-current animate-bounce`} style="animation-delay: 300ms;"></div>
    </div>
  )}

  {variant === 'pulse' && (
    <div class={`${sizeStyles[size]} rounded-full bg-current animate-pulse ${colorStyles[color]} opacity-75`}></div>
  )}

  {variant === 'bars' && (
    <div class={`flex items-center gap-0.5 ${colorStyles[color]}`}>
      <div class={`${barSizes[size]} rounded-full bg-current animate-pulse`} style="animation-delay: 0ms;"></div>
      <div class={`${barSizes[size]} rounded-full bg-current animate-pulse`} style="animation-delay: 150ms;"></div>
      <div class={`${barSizes[size]} rounded-full bg-current animate-pulse`} style="animation-delay: 300ms;"></div>
      <div class={`${barSizes[size]} rounded-full bg-current animate-pulse`} style="animation-delay: 450ms;"></div>
    </div>
  )}

  <span class="sr-only">{label}</span>
</div>

<style>
  @keyframes bounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-50%);
    }
  }
</style>
