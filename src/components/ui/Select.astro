---
/**
 * Select Component
 * Styled dropdown select with label and error states.
 */
interface Option {
  value: string;
  label: string;
  disabled?: boolean;
}

interface OptionGroup {
  label: string;
  options: Option[];
}

interface Props {
  name: string;
  id?: string;
  label?: string;
  options: (Option | OptionGroup)[];
  value?: string;
  placeholder?: string;
  required?: boolean;
  disabled?: boolean;
  error?: string;
  hint?: string;
  class?: string;
}

const {
  name,
  id = name,
  label,
  options,
  value,
  placeholder,
  required = false,
  disabled = false,
  error,
  hint,
  class: className = '',
} = Astro.props;

const selectStyles = `
  w-full
  px-4 py-2.5
  bg-[rgb(var(--color-background))]
  border border-[rgb(var(--color-border))]
  rounded-[var(--radius-md)]
  text-[rgb(var(--color-text))]
  transition-all duration-[var(--transition-fast)]
  focus:outline-none focus:border-[rgb(var(--color-primary))] focus:ring-2 focus:ring-[rgb(var(--color-primary))]/20
  disabled:opacity-50 disabled:cursor-not-allowed disabled:bg-[rgb(var(--color-surface))]
  appearance-none
  cursor-pointer
  pr-10
`;

const errorStyles = error ? 'border-[rgb(var(--color-error))] focus:border-[rgb(var(--color-error))] focus:ring-[rgb(var(--color-error))]/20' : '';

const classes = [selectStyles, errorStyles, className].join(' ');

function isOptionGroup(option: Option | OptionGroup): option is OptionGroup {
  return 'options' in option;
}
---

<div class="space-y-1.5">
  {label && (
    <label for={id} class="block text-sm font-medium text-[rgb(var(--color-text))]">
      {label}
      {required && <span class="text-[rgb(var(--color-error))] ml-1" aria-hidden="true">*</span>}
    </label>
  )}

  <div class="relative">
    <select
      name={name}
      id={id}
      required={required}
      disabled={disabled}
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={error ? `${id}-error` : hint ? `${id}-hint` : undefined}
      class={classes}
    >
      {placeholder && (
        <option value="" disabled selected={!value}>
          {placeholder}
        </option>
      )}

      {options.map((option) => {
        if (isOptionGroup(option)) {
          return (
            <optgroup label={option.label}>
              {option.options.map((opt) => (
                <option
                  value={opt.value}
                  disabled={opt.disabled}
                  selected={opt.value === value}
                >
                  {opt.label}
                </option>
              ))}
            </optgroup>
          );
        }
        return (
          <option
            value={option.value}
            disabled={option.disabled}
            selected={option.value === value}
          >
            {option.label}
          </option>
        );
      })}
    </select>

    <!-- Custom dropdown arrow -->
    <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
      <svg class="w-5 h-5 text-[rgb(var(--color-text-muted))]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </div>
  </div>

  {hint && !error && (
    <p id={`${id}-hint`} class="text-sm text-[rgb(var(--color-text-muted))]">
      {hint}
    </p>
  )}

  {error && (
    <p id={`${id}-error`} class="text-sm text-[rgb(var(--color-error))] flex items-center gap-1" role="alert">
      <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
      </svg>
      {error}
    </p>
  )}
</div>
