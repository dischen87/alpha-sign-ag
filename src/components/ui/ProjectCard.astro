---
/**
 * ProjectCard Component
 * Displays a project card with image, title, and category badge
 * Includes hover overlay effect
 */
interface Props {
  slug: string;
  title: string;
  category: string;
  client: string;
  image: string;
  href: string;
  lang?: 'de' | 'en';
}

const {
  slug,
  title,
  category,
  client,
  image,
  href,
  lang = 'de',
} = Astro.props;

const viewProjectText = lang === 'de' ? 'Projekt ansehen' : 'View Project';
---

<a
  href={href}
  class="project-card group block relative overflow-hidden rounded-[var(--radius)] bg-card border border-border shadow-sm hover:shadow-xl hover:-translate-y-2 hover:border-primary/50 dark:border-border dark:hover:border-primary/50 active:scale-[0.99]"
  data-category={category}
>
  <!-- Image Container -->
  <div class="aspect-[4/3] overflow-hidden">
    <img
      src={image}
      alt={title}
      class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-110"
      loading="lazy"
    />

    <!-- Hover Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-primary-900/90 via-primary-900/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center pb-8">
      <span class="inline-flex items-center gap-2 px-4 py-2 bg-white text-primary-700 font-medium rounded-full transform translate-y-4 group-hover:translate-y-0 transition-all duration-300 hover:scale-105">
        {viewProjectText}
        <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </span>
    </div>
  </div>

  <!-- Content -->
  <div class="p-5 lg:p-6">
    <!-- Category Badge -->
    <span class="inline-block px-3 py-1 text-xs font-semibold tracking-wide uppercase bg-primary/10 text-primary rounded-full mb-3">
      {category}
    </span>

    <!-- Title -->
    <h3 class="text-lg font-bold text-foreground mb-1 group-hover:text-primary transition-colors leading-tight">
      {title}
    </h3>

    <!-- Client -->
    <p class="text-sm text-muted-foreground leading-relaxed">
      {client}
    </p>
  </div>
</a>

<style>
  .project-card {
    /* Ensure smooth filtering and hover animation */
    transition: opacity 0.3s cubic-bezier(0.25, 0.1, 0.25, 1),
                transform 0.3s cubic-bezier(0.25, 0.1, 0.25, 1),
                box-shadow 0.3s cubic-bezier(0.25, 0.1, 0.25, 1),
                border-color 0.3s ease;
  }

  .project-card.hidden {
    opacity: 0;
    transform: scale(0.95);
    pointer-events: none;
    position: absolute;
  }

  .project-card.visible {
    opacity: 1;
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card {
      transition: none !important;
    }
    .project-card img {
      transition: none !important;
    }
  }
</style>
