---
/**
 * Footer Component
 * Multi-column responsive footer with i18n support and Schema.org LocalBusiness structured data
 * Uses theme CSS variables for consistent styling
 */
import { getLocaleFromUrl, useTranslations, getLocalizedUrl, type Locale } from '../../i18n/utils';
import LanguageSwitcher from '../LanguageSwitcher.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const locale = getLocaleFromUrl(Astro.url) as Locale;
const t = useTranslations(locale);

// Company Information
const company = {
  name: 'Alpha Sign AG',
  address: {
    street: 'Industriestrasse 15',
    postalCode: '6331',
    city: 'Hünenberg',
    region: 'ZG',
    country: 'Switzerland',
    countryCode: 'CH',
  },
  phone: '+41 41 780 05 05',
  phoneFormatted: '+41 41 780 05 05',
  email: 'info@alphasign.ch',
  foundingYear: 1989,
  geo: {
    latitude: 47.1756,
    longitude: 8.4267,
  },
};

// Google Maps URL
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${company.address.street}, ${company.address.postalCode} ${company.address.city}, ${company.address.country}`
)}`;

// Dynamic year for copyright
const currentYear = new Date().getFullYear();

// Services links configuration
const services = [
  { key: 'vehicleGraphics', slugDe: 'fahrzeugbeschriftung', slugEn: 'vehicle-lettering' },
  { key: 'illuminatedSigns', slugDe: 'leuchtreklame', slugEn: 'illuminated-signs' },
  { key: 'wayfinding', slugDe: 'signaletik', slugEn: 'wayfinding' },
  { key: 'carWrapping', slugDe: 'car-wrapping', slugEn: 'car-wrapping' },
  { key: 'buildingSignage', slugDe: 'gebaeudebeschriftung', slugEn: 'building-signage' },
  { key: 'tradeShows', slugDe: 'messeauftritte', slugEn: 'trade-shows' },
  { key: 'artInArchitecture', slugDe: 'kunst-am-bau', slugEn: 'art-in-architecture' },
  { key: 'digitalPrinting', slugDe: 'fine-art-prints', slugEn: 'fine-art-prints' },
];

// Company links configuration
// Note: FAQ removed as FAQs are now integrated into service pages (accessible via service page #faq anchors)
const companyLinks = [
  { key: 'about', slugDe: 'ueber-uns', slugEn: 'about' },
  { key: 'portfolio', slugDe: 'portfolio', slugEn: 'portfolio' },
  { key: 'contact', slugDe: 'kontakt', slugEn: 'contact' },
];

// Legal links configuration
const legalLinks = [
  { key: 'imprint', slugDe: 'impressum', slugEn: 'imprint' },
  { key: 'privacy', slugDe: 'datenschutz', slugEn: 'privacy' },
  { key: 'terms', slugDe: 'agb', slugEn: 'terms' },
];

// Social media links
const socialLinks = [
  {
    name: 'LinkedIn',
    url: 'https://www.linkedin.com/company/alpha-sign-ag',
    icon: 'linkedin',
  },
  {
    name: 'Instagram',
    url: 'https://www.instagram.com/alphasignag',
    icon: 'instagram',
  },
  {
    name: 'Facebook',
    url: 'https://www.facebook.com/alphasignag',
    icon: 'facebook',
  },
];

// Build Schema.org LocalBusiness structured data
const siteUrl = Astro.site?.href || Astro.url.origin;
const schemaOrgData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${siteUrl}#organization`,
  name: company.name,
  legalName: company.name,
  url: siteUrl,
  logo: `${siteUrl}/logo.png`,
  image: `${siteUrl}/og-image.jpg`,
  description: t('footer.companyDescription'),
  foundingDate: company.foundingYear.toString(),
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.address.street,
    addressLocality: company.address.city,
    addressRegion: company.address.region,
    postalCode: company.address.postalCode,
    addressCountry: company.address.countryCode,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: company.geo.latitude,
    longitude: company.geo.longitude,
  },
  telephone: company.phone,
  email: company.email,
  priceRange: '$$',
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '17:00',
    },
  ],
  sameAs: socialLinks.map((link) => link.url),
  areaServed: [
    { '@type': 'Country', name: 'Switzerland' },
    { '@type': 'AdministrativeArea', name: 'Zug' },
    { '@type': 'AdministrativeArea', name: 'Luzern' },
    { '@type': 'AdministrativeArea', name: 'Zuerich' },
  ],
};

// Helper function to get localized service URL (with trailing slash)
function getServiceUrl(service: { slugDe: string; slugEn: string }): string {
  const slug = locale === 'en' ? service.slugEn : service.slugDe;
  const basePath = locale === 'en' ? '/en/services/' : '/dienstleistungen/';
  return basePath + slug + '/';
}

// Helper function to get localized company link URL (with trailing slash)
function getCompanyLinkUrl(link: { slugDe: string; slugEn: string }): string {
  const slug = locale === 'en' ? link.slugEn : link.slugDe;
  const url = getLocalizedUrl(`/${slug}`, locale);
  return url.endsWith('/') ? url : url + '/';
}

// Helper function to get localized legal link URL (with trailing slash)
function getLegalLinkUrl(link: { slugDe: string; slugEn: string }): string {
  const slug = locale === 'en' ? link.slugEn : link.slugDe;
  const url = getLocalizedUrl(`/${slug}`, locale);
  return url.endsWith('/') ? url : url + '/';
}
---

<footer class:list={['bg-secondary text-secondary-foreground border-t border-secondary-foreground/10', className]} role="contentinfo">
  <!-- Schema.org LocalBusiness Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaOrgData)} />

  <!-- Main Footer Content -->
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">

      <!-- Column 1: Logo, Description, Social Links -->
      <div class="space-y-6">
        <!-- Logo -->
        <a href={getLocalizedUrl('/', locale)} class="inline-block">
          <img
            src="/alpha-sign-logo-hell.png"
            alt="Alpha Sign AG"
            class="h-12 w-auto brightness-0 invert"
          />
        </a>

        <!-- Company Description -->
        <p class="text-sm leading-relaxed text-secondary-foreground/90" style="line-height: 1.7;">
          {t('footer.companyDescription')}
        </p>

        <!-- Social Links -->
        <div class="flex items-center space-x-3">
          {socialLinks.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center w-10 h-10 rounded-full bg-secondary-foreground/10 text-secondary-foreground/90 transition-all duration-200 hover:bg-primary hover:text-primary-foreground"
              aria-label={social.name}
            >
              {social.icon === 'linkedin' && (
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
              )}
              {social.icon === 'instagram' && (
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd"/>
                </svg>
              )}
              {social.icon === 'facebook' && (
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd"/>
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>

      <!-- Column 2: Services -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-secondary-foreground">
          {t('footer.servicesTitle')}
        </h3>
        <ul class="space-y-3">
          {services.map((service) => (
            <li>
              <a
                href={getServiceUrl(service)}
                class="text-sm text-secondary-foreground/90 transition-colors duration-200 hover:text-secondary-foreground"
              >
                {t(`footer.services.${service.key}`)}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Company Links -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-secondary-foreground">
          {t('footer.companyTitle')}
        </h3>
        <ul class="space-y-3">
          {companyLinks.map((link) => (
            <li>
              <a
                href={getCompanyLinkUrl(link)}
                class="text-sm text-secondary-foreground/90 transition-colors duration-200 hover:text-secondary-foreground"
              >
                {t(`footer.${link.key}`)}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Contact Info -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-secondary-foreground">
          {t('footer.contactTitle')}
        </h3>
        <address class="not-italic">
          <ul class="space-y-3 text-sm text-secondary-foreground/90">
            <!-- Address -->
            <li class="flex items-start">
              <svg class="mr-3 mt-0.5 h-5 w-5 flex-shrink-0 text-secondary-foreground/80" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span>
                {company.name}<br />
                {company.address.street}<br />
                {company.address.postalCode} {company.address.city}<br />
                {company.address.country}
              </span>
            </li>

            <!-- Phone -->
            <li>
              <a
                href={`tel:${company.phone.replace(/\s/g, '')}`}
                class="flex items-center transition-colors duration-200 hover:text-secondary-foreground"
              >
                <svg class="mr-3 h-5 w-5 flex-shrink-0 text-secondary-foreground/80" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                {company.phoneFormatted}
              </a>
            </li>

            <!-- Email -->
            <li>
              <a
                href={`mailto:${company.email}`}
                class="flex items-center transition-colors duration-200 hover:text-secondary-foreground"
              >
                <svg class="mr-3 h-5 w-5 flex-shrink-0 text-secondary-foreground/80" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                {company.email}
              </a>
            </li>

            <!-- Map Link -->
            <li>
              <a
                href={mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center text-sm font-medium text-secondary-foreground transition-colors duration-200 hover:text-secondary-foreground/80"
              >
                <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
                </svg>
                {t('footer.viewOnMap')}
              </a>
            </li>
          </ul>
        </address>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-secondary-foreground/10">
    <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
      <div class="flex flex-col items-center justify-between space-y-4 md:flex-row md:space-y-0">

        <!-- Copyright -->
        <div class="text-sm text-secondary-foreground/85">
          &copy; {currentYear} {company.name}. {t('footer.copyright')}
        </div>

        <!-- Legal Links -->
        <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2" aria-label="Legal">
          {legalLinks.map((link) => (
            <a
              href={getLegalLinkUrl(link)}
              class="text-sm text-secondary-foreground/85 transition-colors duration-200 hover:text-secondary-foreground"
            >
              {t(`footer.${link.key}`)}
            </a>
          ))}
        </nav>

        <!-- Language Switcher -->
        <div class="footer-language-switcher">
          <LanguageSwitcher class="text-secondary-foreground/60" />
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Override LanguageSwitcher styles for footer */
  .footer-language-switcher :global(.language-switcher a) {
    color: var(--secondary-foreground);
    opacity: 0.85;
  }

  .footer-language-switcher :global(.language-switcher a:hover) {
    color: var(--secondary-foreground);
    opacity: 1;
    background-color: rgba(255, 255, 255, 0.1);
  }

  .footer-language-switcher :global(.language-switcher a.active) {
    color: var(--secondary-foreground);
    opacity: 1;
    background-color: rgba(255, 255, 255, 0.05);
  }
</style>
