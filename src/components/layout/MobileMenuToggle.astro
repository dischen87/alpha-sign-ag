---
/**
 * Mobile Menu Toggle Button
 * Hamburger button that toggles the mobile menu drawer
 * Uses theme CSS variables for consistent styling
 */
import { useTranslations, type Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className } = Astro.props;
const t = useTranslations(locale);
---

<button
  id="mobile-menu-toggle"
  type="button"
  class:list={[
    'inline-flex items-center justify-center rounded-lg p-2.5 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 lg:hidden min-w-[44px] min-h-[44px]',
    className,
  ]}
  aria-label={t('nav.openMenu')}
  aria-expanded="false"
  aria-controls="mobile-menu"
>
  <!-- Hamburger Icon -->
  <svg
    class="hamburger-icon h-6 w-6"
    fill="none"
    viewBox="0 0 24 24"
    stroke-width="2"
    stroke="currentColor"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
    />
  </svg>
</button>

<style>
  /* Animated hamburger icon */
  .hamburger-icon {
    transition: transform 0.2s ease;
  }

  button[aria-expanded='true'] .hamburger-icon {
    transform: rotate(90deg);
  }
</style>
