---
/**
 * CTA Section Component
 * Call-to-action section for quote requests
 * Professional Swiss design with primary color scheme
 */
import { useTranslations, getLocaleFromUrl, getLocalizedUrl, type Locale } from '../../i18n/utils';

interface Props {
  locale?: Locale;
  phoneNumber?: string;
}

const currentLocale = (Astro.props.locale ?? getLocaleFromUrl(Astro.url)) as Locale;
const t = useTranslations(currentLocale);

const { phoneNumber = '+41 41 780 05 05' } = Astro.props;
---

<section id="contact-cta" class="relative py-16 lg:py-24 bg-primary scroll-animate scroll-scale-up" data-scroll-animate>
  <!-- Content -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <!-- Headline -->
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-primary-foreground mb-4 tracking-tight">
      {t('cta.title')}
    </h2>

    <!-- Subheadline -->
    <p class="text-lg sm:text-xl text-primary-foreground/85 max-w-2xl mx-auto mb-10 leading-relaxed">
      {t('cta.subtitle')}
    </p>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-8">
      <a
        href={getLocalizedUrl('/kontakt', currentLocale)}
        class="group inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-primary bg-primary-foreground rounded-[var(--radius)] hover:bg-primary-foreground/95 hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 shadow-lg hover:shadow-xl focus:outline-none focus:ring-2 focus:ring-primary-foreground focus:ring-offset-2 focus:ring-offset-primary"
      >
        {t('cta.button')}
        <svg class="ml-2 w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>

    <!-- Phone CTA -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 text-primary-foreground/85">
      <span class="font-medium">{t('cta.phone')}</span>
      <a
        href={`tel:${phoneNumber.replace(/\s/g, '')}`}
        class="inline-flex items-center gap-2 text-xl font-bold text-primary-foreground hover:underline focus:outline-none focus:ring-2 focus:ring-primary-foreground focus:ring-offset-2 focus:ring-offset-primary rounded"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        {phoneNumber}
      </a>
    </div>

    <!-- Trust indicators -->
    <div class="mt-12 flex flex-wrap justify-center items-center gap-6 text-primary-foreground/70">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span class="text-sm font-medium">{currentLocale === 'de' ? 'Kostenlose Beratung' : 'Free Consultation'}</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span class="text-sm font-medium">{currentLocale === 'de' ? 'Unverbindliche Offerte' : 'No-obligation Quote'}</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span class="text-sm font-medium">{currentLocale === 'de' ? 'Schnelle Antwort' : 'Quick Response'}</span>
      </div>
    </div>
  </div>
</section>

<script>
  // Initialize scroll animations for CTA section
  function initCTAAnimations() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      document.querySelectorAll('#contact-cta[data-scroll-animate]').forEach(el => {
        el.classList.add('is-visible');
      });
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -50px 0px' }
    );

    document.querySelectorAll('#contact-cta[data-scroll-animate]').forEach(el => {
      observer.observe(el);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCTAAnimations);
  } else {
    initCTAAnimations();
  }
  document.addEventListener('astro:page-load', initCTAAnimations);
</script>
