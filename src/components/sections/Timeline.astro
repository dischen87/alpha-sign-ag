---
/**
 * Timeline Component
 * Displays company history milestones in a visual timeline format
 * Supports both German and English languages
 */

interface TimelineItem {
  year: string;
  title: string;
  description: string;
  highlight?: boolean;
}

interface Props {
  items: TimelineItem[];
  lang?: 'de' | 'en';
}

const { items, lang = 'de' } = Astro.props;

const sectionTitle = lang === 'de' ? 'Unsere Geschichte' : 'Our History';
const sectionSubtitle = lang === 'de'
  ? 'Mehr als 35 Jahre Erfahrung in der Schilderbranche'
  : 'More than 35 years of experience in the signage industry';
---

<section class="py-16 md:py-24 bg-[var(--background-secondary)]" aria-labelledby="timeline-heading" id="timeline">
  <div class="container mx-auto px-4 max-w-6xl">
    <!-- Section Header -->
    <div class="text-center mb-12 md:mb-16 scroll-animate scroll-fade-up" data-scroll-animate>
      <h2
        id="timeline-heading"
        class="text-3xl md:text-4xl lg:text-5xl font-bold text-[var(--foreground)] mb-4"
      >
        {sectionTitle}
      </h2>
      <p class="text-lg md:text-xl text-[var(--foreground-secondary)] max-w-2xl mx-auto">
        {sectionSubtitle}
      </p>
    </div>

    <!-- Timeline -->
    <div class="relative">
      <!-- Vertical Line -->
      <div
        class="absolute left-4 md:left-1/2 top-0 bottom-0 w-0.5 bg-[var(--border)] md:-translate-x-1/2"
        aria-hidden="true"
      ></div>

      <!-- Timeline Items -->
      <div class="space-y-8 md:space-y-12">
        {items.map((item, index) => (
          <div
            class={`relative flex flex-col md:flex-row ${
              index % 2 === 0 ? 'md:flex-row scroll-animate scroll-slide-left' : 'md:flex-row-reverse scroll-animate scroll-slide-right'
            } items-start md:items-center gap-4 md:gap-8`}
            data-scroll-animate
            data-delay={index + 1}
          >
            <!-- Year Badge -->
            <div
              class={`absolute left-0 md:left-1/2 md:-translate-x-1/2 z-10 flex items-center justify-center w-8 h-8 md:w-16 md:h-16 rounded-full ${
                item.highlight
                  ? 'bg-[var(--primary)] text-[var(--primary-foreground)]'
                  : 'bg-[var(--background)] border-2 border-[var(--border)] text-[var(--foreground)]'
              } font-bold text-xs md:text-base shadow-md`}
            >
              <span class="hidden md:block">{item.year}</span>
              <span class="block md:hidden w-3 h-3 rounded-full bg-current"></span>
            </div>

            <!-- Content Card -->
            <div
              class={`ml-12 md:ml-0 md:w-[calc(50%-3rem)] ${
                index % 2 === 0 ? 'md:pr-8 md:text-right' : 'md:pl-8 md:text-left'
              }`}
            >
              <div
                class={`bg-[var(--card)] rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow duration-300 ${
                  item.highlight ? 'ring-2 ring-[var(--primary)]' : ''
                }`}
              >
                <div class="flex items-center gap-3 mb-2 md:hidden">
                  <span class="text-sm font-semibold text-[var(--primary)]">{item.year}</span>
                </div>
                <h3 class="text-xl font-bold text-[var(--foreground)] mb-2">
                  {item.title}
                </h3>
                <p class="text-[var(--foreground-secondary)]">
                  {item.description}
                </p>
              </div>
            </div>

            <!-- Spacer for alternating layout -->
            <div class="hidden md:block md:w-[calc(50%-3rem)]"></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Animation for timeline items on scroll */
  @media (prefers-reduced-motion: no-preference) {
    [data-timeline-item] {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    }

    [data-timeline-item].visible {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  // Initialize scroll animations for Timeline section
  function initTimelineAnimations() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      document.querySelectorAll('#timeline [data-scroll-animate]').forEach(el => {
        el.classList.add('is-visible');
      });
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
    );

    document.querySelectorAll('#timeline [data-scroll-animate]').forEach(el => {
      observer.observe(el);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTimelineAnimations);
  } else {
    initTimelineAnimations();
  }
  document.addEventListener('astro:page-load', initTimelineAnimations);
</script>
