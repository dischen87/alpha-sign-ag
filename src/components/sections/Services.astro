---
/**
 * Services Section Component
 * Tab-based navigation with service details
 * Mobile: horizontal scrolling tabs
 * Desktop: full tab bar
 */
import { useTranslations, getLocaleFromUrl, getLocalizedUrl, type Locale } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}

const currentLocale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(currentLocale);

// Service definitions with icon names and URLs
const services = [
  { key: 'vehicleLettering', icon: 'truck', slug: 'fahrzeugbeschriftung', slugEn: 'vehicle-lettering' },
  { key: 'illuminatedSigns', icon: 'lightbulb', slug: 'leuchtreklame', slugEn: 'illuminated-signs' },
  { key: 'signage', icon: 'signpost', slug: 'signaletik', slugEn: 'wayfinding' },
  { key: 'carWrapping', icon: 'car', slug: 'car-wrapping', slugEn: 'car-wrapping' },
  { key: 'buildingLettering', icon: 'building', slug: 'gebaeudebeschriftung', slugEn: 'building-signage' },
  { key: 'tradeShows', icon: 'presentation', slug: 'messeauftritte', slugEn: 'trade-shows' },
  { key: 'artInArchitecture', icon: 'palette', slug: 'kunst-am-bau', slugEn: 'art-in-architecture' },
  { key: 'fineArtPrints', icon: 'image', slug: 'fine-art-prints', slugEn: 'fine-art-prints' },
] as const;

// Get service URL based on locale
const getServiceUrl = (service: typeof services[number]) => {
  const basePath = currentLocale === 'de' ? '/dienstleistungen' : '/en/services';
  const slug = currentLocale === 'de' ? service.slug : service.slugEn;
  return `${basePath}/${slug}`;
};
---

<section id="services" class="py-16 lg:py-24 bg-muted/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <span class="inline-block px-4 py-1.5 mb-4 text-sm font-semibold text-primary bg-primary/10 rounded-full">
        {currentLocale === 'de' ? 'Unsere Dienstleistungen' : 'Our Services'}
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground mb-4 tracking-tight">
        {t('services.title')}
      </h2>
      <p class="text-lg sm:text-xl text-muted-foreground max-w-2xl mx-auto leading-relaxed">
        {t('services.subtitle')}
      </p>
    </div>

    <!-- Tabs Navigation -->
    <div class="relative mb-8">
      <!-- Mobile: Horizontal scroll container -->
      <div class="overflow-x-auto scrollbar-hide -mx-4 px-4 lg:mx-0 lg:px-0">
        <div class="flex lg:flex-wrap lg:justify-center gap-2 min-w-max lg:min-w-0" role="tablist" aria-label={currentLocale === 'de' ? 'Dienstleistungen' : 'Services'}>
          {services.map((service, index) => (
            <button
              type="button"
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`panel-${service.key}`}
              id={`tab-${service.key}`}
              data-service-tab={service.key}
              class:list={[
                'service-tab flex items-center gap-2 px-4 py-3 rounded-full text-sm font-medium transition-all duration-200 whitespace-nowrap',
                'focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2',
                index === 0
                  ? 'bg-primary text-white shadow-md'
                  : 'bg-card text-foreground border border-border hover:bg-primary/10 hover:border-primary/30'
              ]}
            >
              <span class="service-tab-icon w-5 h-5" aria-hidden="true">
                {service.icon === 'truck' && (
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 17h8M8 17a2 2 0 11-4 0 2 2 0 014 0zm8 0a2 2 0 104 0 2 2 0 00-4 0zM3 9h13l3 8H3V9z" />
                  </svg>
                )}
                {service.icon === 'lightbulb' && (
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                  </svg>
                )}
                {service.icon === 'signpost' && (
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m-7-8h14l-3-3m0 6l3-3" />
                  </svg>
                )}
                {service.icon === 'car' && (
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 17h14M7 9l2-4h6l2 4M5 17a2 2 0 002 2h10a2 2 0 002-2M5 17V9h14v8" />
                  </svg>
                )}
                {service.icon === 'building' && (
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                )}
                {service.icon === 'presentation' && (
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" />
                  </svg>
                )}
                {service.icon === 'palette' && (
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                  </svg>
                )}
                {service.icon === 'image' && (
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                )}
              </span>
              <span class="hidden sm:inline">{t(`services.items.${service.key}.title`)}</span>
              <span class="sm:hidden">{t(`services.items.${service.key}.title`).split(' ')[0]}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Scroll indicators for mobile -->
      <div class="absolute right-0 top-0 bottom-0 w-8 bg-gradient-to-l from-muted/30 to-transparent pointer-events-none lg:hidden"></div>
    </div>

    <!-- Tab Panels -->
    <div class="relative">
      {services.map((service, index) => (
        <div
          id={`panel-${service.key}`}
          role="tabpanel"
          aria-labelledby={`tab-${service.key}`}
          data-service-panel={service.key}
          class:list={[
            'service-panel transition-all duration-300',
            index === 0 ? 'block' : 'hidden'
          ]}
        >
          <div class="bg-card border border-border rounded-2xl shadow-lg overflow-hidden">
            <div class="grid lg:grid-cols-2 gap-0">
              <!-- Image Side -->
              <div class="relative h-64 lg:h-auto lg:min-h-[400px] bg-gradient-to-br from-primary/20 to-secondary/20">
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="w-32 h-32 lg:w-48 lg:h-48 rounded-2xl bg-primary/10 flex items-center justify-center">
                    <span class="text-primary" aria-hidden="true">
                      {service.icon === 'truck' && (
                        <svg class="w-16 h-16 lg:w-24 lg:h-24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 17h8M8 17a2 2 0 11-4 0 2 2 0 014 0zm8 0a2 2 0 104 0 2 2 0 00-4 0zM3 9h13l3 8H3V9z" />
                        </svg>
                      )}
                      {service.icon === 'lightbulb' && (
                        <svg class="w-16 h-16 lg:w-24 lg:h-24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                        </svg>
                      )}
                      {service.icon === 'signpost' && (
                        <svg class="w-16 h-16 lg:w-24 lg:h-24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m-7-8h14l-3-3m0 6l3-3" />
                        </svg>
                      )}
                      {service.icon === 'car' && (
                        <svg class="w-16 h-16 lg:w-24 lg:h-24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 17h14M7 9l2-4h6l2 4M5 17a2 2 0 002 2h10a2 2 0 002-2M5 17V9h14v8" />
                        </svg>
                      )}
                      {service.icon === 'building' && (
                        <svg class="w-16 h-16 lg:w-24 lg:h-24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                        </svg>
                      )}
                      {service.icon === 'presentation' && (
                        <svg class="w-16 h-16 lg:w-24 lg:h-24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" />
                        </svg>
                      )}
                      {service.icon === 'palette' && (
                        <svg class="w-16 h-16 lg:w-24 lg:h-24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                        </svg>
                      )}
                      {service.icon === 'image' && (
                        <svg class="w-16 h-16 lg:w-24 lg:h-24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                      )}
                    </span>
                  </div>
                </div>
              </div>

              <!-- Content Side -->
              <div class="p-8 lg:p-12 flex flex-col justify-center">
                <h3 class="text-2xl lg:text-3xl font-bold text-foreground mb-4">
                  {t(`services.items.${service.key}.title`)}
                </h3>
                <p class="text-muted-foreground leading-relaxed mb-6 text-base lg:text-lg">
                  {t(`services.items.${service.key}.description`)}
                </p>

                <!-- Features/Benefits -->
                <ul class="space-y-3 mb-8">
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-secondary mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span class="text-foreground">{currentLocale === 'de' ? 'Hochwertige Materialien' : 'Premium materials'}</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-secondary mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span class="text-foreground">{currentLocale === 'de' ? 'Professionelle Montage' : 'Professional installation'}</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-secondary mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span class="text-foreground">{currentLocale === 'de' ? 'Kostenlose Beratung' : 'Free consultation'}</span>
                  </li>
                </ul>

                <!-- CTA Button -->
                <div class="flex flex-col sm:flex-row gap-4">
                  <a
                    href={getServiceUrl(service)}
                    class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-primary text-white font-semibold rounded-lg shadow-md transition-all duration-200 hover:bg-primary/90 hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
                  >
                    {currentLocale === 'de' ? 'Mehr erfahren' : 'Learn more'}
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </a>
                  <a
                    href={getLocalizedUrl('/kontakt', currentLocale)}
                    class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-transparent text-foreground font-semibold rounded-lg border-2 border-border transition-all duration-200 hover:bg-muted hover:border-primary/30 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
                  >
                    {currentLocale === 'de' ? 'Angebot anfragen' : 'Request quote'}
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- View All Services Link -->
    <div class="text-center mt-10">
      <a
        href={getLocalizedUrl('/dienstleistungen', currentLocale)}
        class="inline-flex items-center gap-2 text-primary font-semibold hover:text-primary/80 transition-colors"
      >
        {currentLocale === 'de' ? 'Alle Dienstleistungen ansehen' : 'View all services'}
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  function initServiceTabs() {
    const tabs = document.querySelectorAll('[data-service-tab]');
    const panels = document.querySelectorAll('[data-service-panel]');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const serviceKey = tab.getAttribute('data-service-tab');

        // Update tabs
        tabs.forEach((t) => {
          const isActive = t.getAttribute('data-service-tab') === serviceKey;
          t.setAttribute('aria-selected', isActive ? 'true' : 'false');

          if (isActive) {
            t.classList.remove('bg-card', 'text-foreground', 'border', 'border-border', 'hover:bg-primary/10', 'hover:border-primary/30');
            t.classList.add('bg-primary', 'text-white', 'shadow-md');
          } else {
            t.classList.remove('bg-primary', 'text-white', 'shadow-md');
            t.classList.add('bg-card', 'text-foreground', 'border', 'border-border', 'hover:bg-primary/10', 'hover:border-primary/30');
          }
        });

        // Update panels
        panels.forEach((panel) => {
          const isActive = panel.getAttribute('data-service-panel') === serviceKey;
          if (isActive) {
            panel.classList.remove('hidden');
            panel.classList.add('block');
          } else {
            panel.classList.remove('block');
            panel.classList.add('hidden');
          }
        });
      });
    });

    // Keyboard navigation
    tabs.forEach((tab, index) => {
      tab.addEventListener('keydown', (e) => {
        let newIndex = index;

        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          newIndex = (index + 1) % tabs.length;
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          newIndex = (index - 1 + tabs.length) % tabs.length;
        } else if (e.key === 'Home') {
          e.preventDefault();
          newIndex = 0;
        } else if (e.key === 'End') {
          e.preventDefault();
          newIndex = tabs.length - 1;
        }

        if (newIndex !== index) {
          (tabs[newIndex] as HTMLElement).click();
          (tabs[newIndex] as HTMLElement).focus();
        }
      });
    });
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', initServiceTabs);

  // Re-initialize on Astro page transitions
  document.addEventListener('astro:page-load', initServiceTabs);
</script>
