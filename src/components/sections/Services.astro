---
/**
 * Services Section Component
 * Grid of 8 services with icons and short descriptions
 */
import { useTranslations, getLocaleFromUrl, type Locale } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}

const currentLocale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(currentLocale);

// Service definitions with icon names
const services = [
  { key: 'vehicleLettering', icon: 'truck' },
  { key: 'illuminatedSigns', icon: 'lightbulb' },
  { key: 'signage', icon: 'signpost' },
  { key: 'carWrapping', icon: 'car' },
  { key: 'buildingLettering', icon: 'building' },
  { key: 'tradeShows', icon: 'presentation' },
  { key: 'artInArchitecture', icon: 'palette' },
  { key: 'fineArtPrints', icon: 'image' },
] as const;
---

<section id="services" class="py-16 lg:py-24 bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16 scroll-animate scroll-fade-up" data-scroll-animate>
      <span class="inline-block px-4 py-1.5 mb-4 text-sm font-semibold text-primary bg-primary/10 rounded-full">
        {currentLocale === 'de' ? 'Unsere Dienstleistungen' : 'Our Services'}
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground mb-4 tracking-tight">
        {t('services.title')}
      </h2>
      <p class="text-lg sm:text-xl text-muted-foreground max-w-2xl mx-auto leading-relaxed">
        {t('services.subtitle')}
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8" data-stagger-container>
      {services.map((service, index) => (
        <article class="group relative bg-card border border-border rounded-[var(--radius)] p-6 lg:p-8 shadow-sm transition-all duration-300 hover:bg-primary hover:border-primary hover:shadow-xl hover:-translate-y-1 dark:border-border dark:hover:border-primary scroll-animate scroll-fade-up" data-scroll-animate data-delay={index + 1}>
          <!-- Icon -->
          <div class="w-14 h-14 mb-5 rounded-xl bg-primary/10 flex items-center justify-center transition-colors duration-300 group-hover:bg-white/20">
            <span class="service-icon text-primary transition-colors duration-300 group-hover:text-white" data-icon={service.icon} aria-hidden="true">
              {service.icon === 'truck' && (
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 17h8M8 17a2 2 0 11-4 0 2 2 0 014 0zm8 0a2 2 0 104 0 2 2 0 00-4 0zM3 9h13l3 8H3V9z" />
                </svg>
              )}
              {service.icon === 'lightbulb' && (
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
              )}
              {service.icon === 'signpost' && (
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m-7-8h14l-3-3m0 6l3-3" />
                </svg>
              )}
              {service.icon === 'car' && (
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 17h14M7 9l2-4h6l2 4M5 17a2 2 0 002 2h10a2 2 0 002-2M5 17V9h14v8" />
                </svg>
              )}
              {service.icon === 'building' && (
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
              )}
              {service.icon === 'presentation' && (
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" />
                </svg>
              )}
              {service.icon === 'palette' && (
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                </svg>
              )}
              {service.icon === 'image' && (
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              )}
            </span>
          </div>

          <!-- Content -->
          <h3 class="text-xl font-bold text-foreground mb-3 transition-colors duration-300 group-hover:text-white">
            {t(`services.items.${service.key}.title`)}
          </h3>
          <p class="text-muted-foreground transition-colors duration-300 group-hover:text-white/80 leading-relaxed">
            {t(`services.items.${service.key}.description`)}
          </p>

          <!-- Hover Arrow -->
          <div class="absolute bottom-6 right-6 lg:bottom-8 lg:right-8 opacity-0 transform translate-x-2 transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-0">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  // Initialize scroll animations for Services section
  function initServicesAnimations() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      document.querySelectorAll('[data-scroll-animate]').forEach(el => {
        el.classList.add('is-visible');
      });
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
    );

    document.querySelectorAll('#services [data-scroll-animate]').forEach(el => {
      observer.observe(el);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initServicesAnimations);
  } else {
    initServicesAnimations();
  }
  document.addEventListener('astro:page-load', initServicesAnimations);
</script>
