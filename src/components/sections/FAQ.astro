---
/**
 * FAQ Section Component
 * Accordion FAQ component with expandable questions
 */
import { useTranslations, getLocaleFromUrl, type Locale } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}

const currentLocale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(currentLocale);

// FAQ items
const faqItems = ['q1', 'q2', 'q3', 'q4', 'q5'] as const;
---

<section id="faq" class="py-20 lg:py-28 bg-slate-50">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-12 scroll-animate scroll-fade-up" data-scroll-animate>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 mb-4">
        {t('faq.title')}
      </h2>
      <p class="text-lg sm:text-xl text-slate-600">
        {t('faq.subtitle')}
      </p>
    </div>

    <!-- FAQ Accordion -->
    <div class="space-y-4" role="region" aria-label={currentLocale === 'de' ? 'Häufig gestellte Fragen' : 'Frequently Asked Questions'}>
      {faqItems.map((item, index) => (
        <div
          class="faq-item bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden scroll-animate scroll-fade-up hover:shadow-md transition-shadow duration-300"
          data-faq-index={index}
          data-scroll-animate
          data-delay={index + 1}
        >
          <button
            type="button"
            class="faq-trigger w-full flex items-center justify-between gap-4 p-6 text-left hover:bg-slate-50 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-amber-400"
            aria-expanded="false"
            aria-controls={`faq-answer-${index}`}
            id={`faq-question-${index}`}
          >
            <span class="text-lg font-semibold text-slate-900 pr-4">
              {t(`faq.items.${item}.question`)}
            </span>
            <span class="faq-icon flex-shrink-0 w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center transition-all duration-300">
              <svg class="w-5 h-5 text-slate-600 transform transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </button>
          <div
            id={`faq-answer-${index}`}
            role="region"
            aria-labelledby={`faq-question-${index}`}
            class="faq-content hidden"
          >
            <div class="px-6 pb-6 pt-0">
              <p class="text-slate-600 leading-relaxed">
                {t(`faq.items.${item}.answer`)}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Contact CTA -->
    <div class="mt-12 text-center">
      <p class="text-slate-600 mb-4">
        {currentLocale === 'de'
          ? 'Haben Sie weitere Fragen? Wir helfen Ihnen gerne!'
          : 'Have more questions? We are happy to help!'}
      </p>
      <a
        href="#contact"
        class="inline-flex items-center gap-2 px-6 py-3 text-base font-semibold text-white bg-slate-900 rounded-lg hover:bg-slate-800 transition-colors duration-300 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:ring-offset-2"
      >
        {t('common.contactUs')}
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  // Initialize scroll animations for FAQ section
  function initFAQAnimations() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      document.querySelectorAll('#faq [data-scroll-animate]').forEach(el => {
        el.classList.add('is-visible');
      });
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -30px 0px' }
    );

    document.querySelectorAll('#faq [data-scroll-animate]').forEach(el => {
      observer.observe(el);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFAQAnimations);
  } else {
    initFAQAnimations();
  }
  document.addEventListener('astro:page-load', initFAQAnimations);

  document.addEventListener('DOMContentLoaded', () => {
    const faqItems = document.querySelectorAll('.faq-item');

    faqItems.forEach(item => {
      const trigger = item.querySelector('.faq-trigger');
      const content = item.querySelector('.faq-content');
      const icon = item.querySelector('.faq-icon svg');

      if (!trigger || !content) return;

      trigger.addEventListener('click', () => {
        const isExpanded = trigger.getAttribute('aria-expanded') === 'true';

        // Close all other items
        faqItems.forEach(otherItem => {
          if (otherItem !== item) {
            const otherTrigger = otherItem.querySelector('.faq-trigger');
            const otherContent = otherItem.querySelector('.faq-content');
            const otherIcon = otherItem.querySelector('.faq-icon svg');

            if (otherTrigger && otherContent && otherIcon) {
              otherTrigger.setAttribute('aria-expanded', 'false');
              otherContent.classList.add('hidden');
              otherIcon.classList.remove('rotate-180');
            }
          }
        });

        // Toggle current item
        trigger.setAttribute('aria-expanded', (!isExpanded).toString());
        content.classList.toggle('hidden');
        icon?.classList.toggle('rotate-180');
      });
    });

    // Allow keyboard navigation
    faqItems.forEach((item, index) => {
      const trigger = item.querySelector('.faq-trigger');

      trigger?.addEventListener('keydown', (e) => {
        const event = e as KeyboardEvent;
        let targetIndex: number | null = null;

        switch (event.key) {
          case 'ArrowDown':
            event.preventDefault();
            targetIndex = index + 1;
            break;
          case 'ArrowUp':
            event.preventDefault();
            targetIndex = index - 1;
            break;
          case 'Home':
            event.preventDefault();
            targetIndex = 0;
            break;
          case 'End':
            event.preventDefault();
            targetIndex = faqItems.length - 1;
            break;
        }

        if (targetIndex !== null && targetIndex >= 0 && targetIndex < faqItems.length) {
          const targetTrigger = faqItems[targetIndex].querySelector('.faq-trigger') as HTMLButtonElement;
          targetTrigger?.focus();
        }
      });
    });
  });
</script>

<style>
  .faq-icon svg {
    transition: transform 0.3s ease;
  }

  .faq-icon svg.rotate-180 {
    transform: rotate(180deg);
  }

  .faq-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease-out;
  }

  .faq-content:not(.hidden) {
    max-height: 500px;
  }
</style>
