---
/**
 * WhyUs Section Component (USP Section)
 * Highlights key selling points: 35+ years experience, 5-star rating, Swiss quality, full-service
 */
import { useTranslations, getLocaleFromUrl, type Locale } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}

const currentLocale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(currentLocale);

// USP items with visual elements
const uspItems = [
  {
    key: 'experience',
    icon: 'calendar',
    highlight: '35+',
    highlightSuffix: currentLocale === 'de' ? 'Jahre' : 'Years'
  },
  {
    key: 'rating',
    icon: 'star',
    highlight: '5',
    highlightSuffix: currentLocale === 'de' ? 'Sterne' : 'Stars'
  },
  {
    key: 'swissQuality',
    icon: 'shield',
    highlight: '100%',
    highlightSuffix: 'Swiss'
  },
  {
    key: 'fullService',
    icon: 'check-circle',
    highlight: 'A-Z',
    highlightSuffix: 'Service'
  },
] as const;
---

<section id="why-us" class="py-16 lg:py-24 bg-primary-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16 scroll-animate scroll-fade-up" data-scroll-animate>
      <span class="inline-block px-4 py-1.5 mb-4 text-sm font-semibold text-primary-300 bg-primary-900 rounded-full">
        {currentLocale === 'de' ? 'Warum Alpha Sign?' : 'Why Alpha Sign?'}
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4 tracking-tight">
        {t('whyUs.title')}
      </h2>
      <p class="text-lg sm:text-xl text-primary-200/80 max-w-2xl mx-auto leading-relaxed">
        {t('whyUs.subtitle')}
      </p>
    </div>

    <!-- USP Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {uspItems.map((item, index) => (
        <article class="relative text-center p-8 rounded-[var(--radius)] bg-primary-900/50 border border-primary-800 hover:border-primary-400/50 transition-all duration-300 group hover:bg-primary-900/70 hover:-translate-y-1 scroll-animate scroll-scale-up" data-scroll-animate data-delay={index + 1}>
          <!-- Highlight Number -->
          <div class="mb-4">
            <span class="text-5xl lg:text-6xl font-bold text-primary-400 tracking-tight">
              {item.highlight}
            </span>
            <span class="block text-sm font-medium text-primary-300 uppercase tracking-wider mt-1">
              {item.highlightSuffix}
            </span>
          </div>

          <!-- Icon -->
          <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-primary-400/10 flex items-center justify-center">
            {item.icon === 'calendar' && (
              <svg class="w-6 h-6 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            )}
            {item.icon === 'star' && (
              <svg class="w-6 h-6 text-primary-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
              </svg>
            )}
            {item.icon === 'shield' && (
              <svg class="w-6 h-6 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            )}
            {item.icon === 'check-circle' && (
              <svg class="w-6 h-6 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            )}
          </div>

          <!-- Content -->
          <h3 class="text-xl font-bold text-white mb-2">
            {t(`whyUs.items.${item.key}.title`)}
          </h3>
          <p class="text-primary-200/70 leading-relaxed">
            {t(`whyUs.items.${item.key}.description`)}
          </p>

          <!-- Decorative corner -->
          <div class="absolute top-0 right-0 w-16 h-16 overflow-hidden rounded-tr-[var(--radius)]">
            <div class="absolute -top-8 -right-8 w-16 h-16 bg-primary-400/5 rotate-45 group-hover:bg-primary-400/10 transition-colors duration-300"></div>
          </div>
        </article>
      ))}
    </div>

    <!-- Trust Badges -->
    <div class="mt-16 flex flex-wrap justify-center items-center gap-8 scroll-animate scroll-fade-up" data-scroll-animate data-delay="5">
      <div class="flex items-center gap-2 text-primary-300/70">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
        </svg>
        <span class="text-sm font-medium">ISO 9001</span>
      </div>
      <div class="flex items-center gap-2 text-primary-300/70">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
        </svg>
        <span class="text-sm font-medium">Swiss Made</span>
      </div>
      <div class="flex items-center gap-2 text-primary-300/70">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
        </svg>
        <span class="text-sm font-medium">{currentLocale === 'de' ? 'Seit 1989' : 'Since 1989'}</span>
      </div>
    </div>
  </div>
</section>

<script>
  // Initialize scroll animations for WhyUs section
  function initWhyUsAnimations() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      document.querySelectorAll('#why-us [data-scroll-animate]').forEach(el => {
        el.classList.add('is-visible');
      });
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
    );

    document.querySelectorAll('#why-us [data-scroll-animate]').forEach(el => {
      observer.observe(el);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWhyUsAnimations);
  } else {
    initWhyUsAnimations();
  }
  document.addEventListener('astro:page-load', initWhyUsAnimations);
</script>
