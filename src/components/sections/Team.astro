---
/**
 * Team Component
 * Displays team members in a responsive grid layout
 * Includes placeholder for photos, name, role, and short bio
 */

interface TeamMember {
  name: string;
  role: string;
  bio: string;
  image?: string;
  email?: string;
  linkedin?: string;
}

interface Props {
  members: TeamMember[];
  lang?: 'de' | 'en';
}

const { members, lang = 'de' } = Astro.props;

const sectionTitle = lang === 'de' ? 'Unser Team' : 'Our Team';
const sectionSubtitle = lang === 'de'
  ? 'Die Menschen hinter Alpha Sign - Experten mit Leidenschaft'
  : 'The people behind Alpha Sign - Passionate experts';
---

<section class="py-16 md:py-24 bg-[var(--background)]" aria-labelledby="team-heading" id="team">
  <div class="container mx-auto px-4 max-w-6xl">
    <!-- Section Header -->
    <div class="text-center mb-12 md:mb-16 scroll-animate scroll-fade-up" data-scroll-animate>
      <h2
        id="team-heading"
        class="text-3xl md:text-4xl lg:text-5xl font-bold text-[var(--foreground)] mb-4"
      >
        {sectionTitle}
      </h2>
      <p class="text-lg md:text-xl text-[var(--foreground-secondary)] max-w-2xl mx-auto">
        {sectionSubtitle}
      </p>
    </div>

    <!-- Team Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {members.map((member, index) => (
        <article
          class="group bg-[var(--card)] rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-2 scroll-animate scroll-fade-up"
          data-scroll-animate
          data-delay={index + 1}
        >
          <!-- Photo Container -->
          <div class="relative aspect-[4/3] bg-[var(--background-secondary)] overflow-hidden">
            {member.image ? (
              <img
                src={member.image}
                alt={`${member.name} - ${member.role}`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            ) : (
              <!-- Placeholder -->
              <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-[var(--color-primary-100)] to-[var(--color-primary-200)]">
                <svg
                  class="w-24 h-24 text-[var(--color-primary-400)]"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                </svg>
              </div>
            )}
          </div>

          <!-- Content -->
          <div class="p-6">
            <h3 class="text-xl font-bold text-[var(--foreground)] mb-1">
              {member.name}
            </h3>
            <p class="text-[var(--primary)] font-medium mb-3">
              {member.role}
            </p>
            <p class="text-[var(--foreground-secondary)] text-sm leading-relaxed mb-4">
              {member.bio}
            </p>

            <!-- Contact Links -->
            {(member.email || member.linkedin) && (
              <div class="flex gap-3 pt-3 border-t border-[var(--border)]">
                {member.email && (
                  <a
                    href={`mailto:${member.email}`}
                    class="text-[var(--foreground-muted)] hover:text-[var(--primary)] transition-colors"
                    aria-label={`Email ${member.name}`}
                  >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                  </a>
                )}
                {member.linkedin && (
                  <a
                    href={member.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[var(--foreground-muted)] hover:text-[var(--primary)] transition-colors"
                    aria-label={`${member.name} auf LinkedIn`}
                  >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                  </a>
                )}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  // Initialize scroll animations for Team section
  function initTeamAnimations() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      document.querySelectorAll('#team [data-scroll-animate]').forEach(el => {
        el.classList.add('is-visible');
      });
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
    );

    document.querySelectorAll('#team [data-scroll-animate]').forEach(el => {
      observer.observe(el);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTeamAnimations);
  } else {
    initTeamAnimations();
  }
  document.addEventListener('astro:page-load', initTeamAnimations);
</script>
