---
/**
 * Building Signage Service Page (English)
 * SEO-optimized for Swiss market
 * Comprehensive content with pricing, process, FAQ, and CTAs
 */
import ServiceLayout from '../../../layouts/ServiceLayout.astro';

const serviceData = {
  title: 'Building Signage',
  description: 'Professional building signage in Switzerland - Facade lettering, 3D letters, company signs and window graphics. CHF 500-20,000. Consultation: +41 41 780 05 05',
  heroImage: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1920&q=80',
  heroImageAlt: '3D letters on modern facade in Switzerland',
  serviceDescription: `Make your company visible with professional building signage from Alpha Sign AG. Whether striking 3D letters on the facade, elegant window graphics, practical company signs at the entrance or large-scale facade advertising - we design and install your exterior advertising from high-quality, weather-resistant materials.

Since 1989, we have been beautifying buildings throughout Switzerland - from small medical practices to corporate headquarters. Our installers are trained and equipped for working at great heights.

**Free on-site consultation: +41 41 780 05 05** - We visit your building and provide a no-obligation quote.`,
  benefits: [
    'High-quality, weather-resistant materials for long durability',
    'Custom designs matching your corporate design',
    '3D letters with or without LED illumination',
    'Professional installation even at great heights (aerial lifts, scaffolding)',
    'Complete permit consultation when required',
    'Maintenance, cleaning and care on request',
    'From individual signs to complete facade design',
    'Swiss quality from our own workshop in Hunenberg',
  ],
  priceRange: {
    min: 500,
    max: 20000,
    note: 'Window graphics from CHF 200, company signs from CHF 500, facade vinyl CHF 500-3,000, 3D letters unlit CHF 1,500-8,000, 3D letters with LED CHF 3,000-15,000, illuminated large installations up to CHF 20,000+.',
  },
  processSteps: [
    {
      title: 'Free Initial Consultation',
      description: 'By phone or on-site, we discuss your wishes and analyze the conditions at your building. Call: +41 41 780 05 05.',
    },
    {
      title: 'Measurements & On-Site Visit',
      description: 'We visit your building, measure the surfaces, check installation options and clarify any permit requirements with you.',
    },
    {
      title: 'Concept & Visualization',
      description: 'You receive photorealistic installation visualizations showing how the signage will look on your building - from different angles and in day/night view.',
    },
    {
      title: 'Permit (if required)',
      description: 'For installations requiring permits (illuminated signs, large 3D letters), we support you with the building application with all required documents.',
    },
    {
      title: 'Production',
      description: 'In our workshop in Hunenberg, we manufacture your signage from aluminum, acrylic glass, stainless steel, Dibond or other materials precisely to measure.',
    },
    {
      title: 'Installation & Quality Control',
      description: 'Our experienced installation team professionally mounts your building signage - even at great heights with aerial lifts or scaffolding. Final inspection follows.',
    },
  ],
  relatedProjects: [
    {
      title: '3D Letters Technopark Zug',
      image: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=400&q=75',
      category: 'Industrial',
      href: '/en/portfolio/technopark-zug',
    },
    {
      title: 'Window Graphics Boutique Mode',
      image: 'https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?auto=format&fit=crop&w=400&q=75',
      category: 'Retail',
      href: '/en/portfolio/boutique-mode',
    },
    {
      title: 'Company Sign Law Firm',
      image: 'https://images.unsplash.com/photo-1497366811353-6870744d04b2?auto=format&fit=crop&w=400&q=75',
      category: 'Professional Services',
      href: '/en/portfolio/anwaltskanzlei',
    },
  ],
  faqs: [
    {
      question: 'What materials are suitable for building signage?',
      answer: 'For outdoor use, we recommend: Aluminum - lightweight, rust-free, powder-coatable in all RAL colors, ideal for 3D letters. Stainless steel - elegant, extremely durable, vandal-resistant. Acrylic glass - modern, can be backlit, many color options. Dibond/Alucobond - stable, weather-resistant, ideal for signs. For windows, vinyl films, decorative glass films or sandblast effect are suitable. We advise on the optimal material choice for your budget and requirements.',
    },
    {
      question: 'Do I need a permit for building signage?',
      answer: 'This depends on type and size: Simple signage (vinyl, small signs, window graphics) is usually permit-free. For larger 3D letters on the facade, illuminated advertising or installations projecting over public ground, a building application may be required. Regulations vary by canton and municipality. In Canton Zug and the region, we are happy to advise on local requirements.',
    },
    {
      question: 'How much do 3D letters for a facade cost?',
      answer: 'Price depends on size, material and illumination: Simple acrylic glass 3D letters (approx. 20-30 cm high) cost from CHF 50-100 per letter. Aluminum letters in the same size CHF 80-150 per letter. With LED backlighting, the price roughly doubles. For a company name with 8-12 letters, expect CHF 1,500-5,000 unlit, CHF 3,000-10,000 with LED. Large letters (50+ cm) correspondingly more.',
    },
    {
      question: 'How long does building signage last?',
      answer: 'With high-quality materials and professional installation: Aluminum signs and letters 15-20+ years, stainless steel practically unlimited, acrylic glass 10-15 years, vinyl films for windows 5-7 years outdoors. LED illumination lasts 50,000+ operating hours (over 15 years at 8h daily operation). Durability depends on weather, sun exposure and maintenance.',
    },
    {
      question: 'Can you install at great heights?',
      answer: 'Yes, our installation team is trained and equipped for working at heights. We work with our own aerial lifts (up to 20m), boom lifts and coordinate scaffolding when needed. We also regularly carry out installations in difficult-to-access locations, historic buildings with heritage protection requirements or industrial buildings. All installers have required safety certifications (SUVA-compliant).',
    },
    {
      question: 'Can existing signage be updated or extended?',
      answer: 'Yes, we regularly update existing installations: Company name changes, new logos, extensions with additional letters or elements. For our own previous projects, we have all specifications documented. But we can also often seamlessly extend third-party signage - we analyze materials and colors and produce matching additions.',
    },
  ],
  keywords: [
    'building signage Switzerland',
    'facade lettering',
    '3D letters facade',
    '3D letters cost',
    'company sign',
    'window graphics',
    'exterior building signage',
    'business signage',
    'channel letters',
    'building signage Zug',
    'facade advertising',
    'entrance sign company',
    'office sign',
    'outdoor business signs',
  ],
};
---

<ServiceLayout
  title={serviceData.title}
  description={serviceData.description}
  heroImage={serviceData.heroImage}
  heroImageAlt={serviceData.heroImageAlt}
  serviceDescription={serviceData.serviceDescription}
  benefits={serviceData.benefits}
  priceRange={serviceData.priceRange}
  processSteps={serviceData.processSteps}
  relatedProjects={serviceData.relatedProjects}
  faqs={serviceData.faqs}
  keywords={serviceData.keywords}
  lang="en"
/>
