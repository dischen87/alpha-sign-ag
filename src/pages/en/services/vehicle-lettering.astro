---
/**
 * Vehicle Lettering Service Page (English)
 * SEO-optimized for international clients in Switzerland
 * Comprehensive content with pricing, process, FAQ, and CTAs
 */
import ServiceLayout from '../../../layouts/ServiceLayout.astro';

const serviceData = {
  title: 'Vehicle Lettering',
  description: 'Professional vehicle lettering in Switzerland - Transform your vehicle into a mobile advertisement. From simple lettering to full wraps. CHF 350-6,000. Free quote: +41 41 780 05 05',
  heroImage: 'https://images.unsplash.com/photo-1619642751034-765dfdf7c58e?auto=format&fit=crop&w=1920&q=80',
  heroImageAlt: 'Professional vehicle lettering on delivery van in Switzerland',
  serviceDescription: `Transform your vehicle into a mobile advertising platform with professional vehicle lettering from Alpha Sign AG. Since 1989, we have been lettering vehicles of all types in Hunenberg, Canton of Zug - from compact cars to heavy trucks, from delivery vans to entire fleets.

With up to 70,000 daily impressions, your lettered vehicle is one of the most cost-effective forms of advertising. Our premium 3M and Avery vinyl films guarantee durability of 5-10 years while simultaneously protecting your vehicle's original paint.

**Call us for a free consultation: +41 41 780 05 05** or use our contact form for a no-obligation quote.`,
  benefits: [
    '5-10 years durability with proper care',
    'Protects original paint - maintains vehicle value',
    'Residue-free removal possible at any time',
    'Mobile advertising with up to 70,000 daily impressions',
    'Custom designs according to your corporate design guidelines',
    'Swiss quality from Hunenberg, Canton Zug',
    'Fleet discounts for companies with 3+ vehicles',
    'Express service available for urgent orders',
  ],
  priceRange: {
    min: 350,
    max: 6000,
    note: 'Simple lettering (logo + contact details) CHF 350-2,500. Full wrap CHF 1,500-6,000. Price depends on vehicle size, design complexity and vinyl material. Fleet discounts on request.',
  },
  processSteps: [
    {
      title: 'Free Initial Consultation',
      description: 'We discuss your requirements by phone or on-site. You receive initial price indications and recommendations for your project. Call: +41 41 780 05 05.',
    },
    {
      title: 'Measurements & Concept',
      description: 'We take exact measurements of your vehicle - either in our workshop or at your location. Based on this, we create an initial design concept.',
    },
    {
      title: 'Design & Visualization',
      description: 'Our design team creates a photorealistic visualization based on your vehicle model. You see exactly what your vehicle will look like after lettering.',
    },
    {
      title: 'Production',
      description: 'After your approval, we produce the vinyl graphics using state-of-the-art printing technology. We exclusively use durable branded films from 3M, Avery Dennison or Oracal.',
    },
    {
      title: 'Professional Installation',
      description: 'Installation takes place in our climate-controlled, dust-free workshop in Hunenberg. Depending on scope, this takes 4-8 hours. Your vehicle is ready the same or next day.',
    },
    {
      title: 'Quality Control & Handover',
      description: 'After final inspection, you receive care instructions for maximum durability, warranty documents and drive away with your new mobile advertising vehicle.',
    },
  ],
  relatedProjects: [
    {
      title: 'Delivery Fleet Mueller Transport AG',
      image: 'https://images.unsplash.com/photo-1619642751034-765dfdf7c58e?auto=format&fit=crop&w=400&q=75',
      category: 'Fleet Graphics',
      href: '/en/portfolio/mueller-transport',
    },
    {
      title: 'Craftsman Business Schreinerei Huber',
      image: 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?auto=format&fit=crop&w=400&q=75',
      category: 'Partial Wrap',
      href: '/en/portfolio/schreinerei-huber',
    },
    {
      title: 'Food Truck Gourmet on Wheels',
      image: 'https://images.unsplash.com/photo-1565123409695-7b5ef63a2efb?auto=format&fit=crop&w=400&q=75',
      category: 'Full Wrap',
      href: '/en/portfolio/food-truck-gourmet',
    },
  ],
  faqs: [
    {
      question: 'How much does vehicle lettering cost in Switzerland?',
      answer: 'Costs vary depending on scope: Simple lettering (logo + contact details on both sides) costs CHF 350-800. Partial wraps with graphics are CHF 800-2,500. A full wrap costs CHF 1,500-6,000 depending on vehicle size. For fleets of 3+ vehicles, we offer attractive volume discounts. Call us for a free quote: +41 41 780 05 05.',
    },
    {
      question: 'How long does vehicle lettering last?',
      answer: 'Using high-quality branded films (3M, Avery Dennison) and professional installation, vehicle lettering lasts 5-10 years. Durability depends on care: Regular hand washing (no car washes with brushes) and garage storage significantly extend the lifespan. We provide a warranty on all lettering.',
    },
    {
      question: 'What materials do you use for vehicle lettering?',
      answer: 'We exclusively use premium vinyl from 3M, Avery Dennison and Oracal. For lettering, we use cast high-performance films with a thickness of 50-80 microns. These are particularly flexible for curves and contours and have UV resistance of 7-10 years. For digital printing, we use laminated print films with additional protection against scratches and fading.',
    },
    {
      question: 'Can vehicle lettering be removed?',
      answer: 'Yes, professionally applied films can be removed without residue. The original paint remains undamaged - in fact, the film has protected the paint from UV radiation and minor scratches. Removal should be performed by professionals and costs CHF 200-800 depending on scope. This is particularly important for leased vehicles.',
    },
    {
      question: 'How long does it take to letter my vehicle?',
      answer: 'Simple lettering (logo + text) is often completed within 4-6 hours - you can pick up your vehicle the same day. For partial wraps, allow 1-2 days; for a full wrap, 2-3 days. For urgent orders, we offer express service - please ask us.',
    },
    {
      question: 'Do I need a permit for vehicle lettering?',
      answer: 'In Switzerland, no permit is required for standard vehicle lettering. For full wraps that change the base color of the vehicle, the new color must be registered in the vehicle documents (cost approximately CHF 50 at the road traffic office). Important: Safety-relevant areas such as windows and taillights must not be covered. We are happy to advise you on all regulations.',
    },
  ],
  keywords: [
    'vehicle lettering Switzerland',
    'vehicle graphics Switzerland',
    'car lettering',
    'fleet graphics',
    'commercial vehicle wrap',
    'delivery van lettering',
    'vehicle advertising',
    'car branding Switzerland',
    'vehicle wrap cost',
    'truck lettering',
    'company vehicle graphics',
    'mobile advertising vehicle',
    'van signage',
    'fleet branding',
  ],
};
---

<ServiceLayout
  title={serviceData.title}
  description={serviceData.description}
  heroImage={serviceData.heroImage}
  heroImageAlt={serviceData.heroImageAlt}
  serviceDescription={serviceData.serviceDescription}
  benefits={serviceData.benefits}
  priceRange={serviceData.priceRange}
  processSteps={serviceData.processSteps}
  relatedProjects={serviceData.relatedProjects}
  faqs={serviceData.faqs}
  keywords={serviceData.keywords}
  lang="en"
/>
