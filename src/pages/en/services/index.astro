---
/**
 * English Services Overview Page
 * SEO-optimized landing page for all services
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Button from '../../../components/ui/Button.astro';

// Page metadata
const pageTitle = 'Services - Signage, Wayfinding & Visual Communication | Alpha Sign AG';
const pageDescription = 'The complete spectrum of professional signage and visual communication: Vehicle lettering, car wrapping, illuminated signs, wayfinding systems, building signage, trade show displays, art in architecture and fine art prints. All from one source in Hunenberg, Canton of Zug, Switzerland.';

// Services data
const services = [
  {
    title: 'Vehicle Lettering',
    description: 'Transform your vehicle into a mobile advertising platform. Professional graphics for cars, vans, trucks and entire vehicle fleets. With high-quality branded films from 3M and Avery, we achieve durability of 5-10 years.',
    href: '/en/services/vehicle-lettering',
    features: ['5-10 years durability', 'Residue-free removal', 'Up to 70,000 daily impressions'],
    priceFrom: 'from CHF 300',
  },
  {
    title: 'Car Wrapping',
    description: 'Full vehicle wraps in premium quality. Color change, paint protection and custom designs - reversible and value-preserving. Protect your original paint from stone chips, scratches and UV radiation.',
    href: '/en/services/car-wrapping',
    features: ['Reversible', 'Paint protection included', 'Unlimited color options'],
    priceFrom: 'from CHF 2,500',
  },
  {
    title: 'Illuminated Signs',
    description: 'LED channel letters and illuminated displays for maximum visibility - day and night. Energy-efficient LED technology with over 50,000 operating hours. We also advise on cantonal permit procedures.',
    href: '/en/services/illuminated-signs',
    features: ['24/7 visibility', 'Up to 80% energy savings', 'Permit consultation included'],
    priceFrom: 'from CHF 2,000',
  },
  {
    title: 'Wayfinding Systems',
    description: 'Professional wayfinding and orientation systems for buildings, premises and public spaces. From the parking garage to the top floor - we guide your visitors safely to their destination. Barrier-free according to SIA 500.',
    href: '/en/services/wayfinding',
    features: ['Accessibility per SIA 500', 'Modular systems', 'Multilingual (DE/FR/IT/EN)'],
    priceFrom: 'from CHF 3,000',
  },
  {
    title: 'Building Signage',
    description: '3D letters, facade signage, window graphics and company signs. High-quality, weather-resistant materials such as aluminum, acrylic glass and stainless steel for outdoor use.',
    href: '/en/services/building-signage',
    features: ['3D letters', 'Weather-resistant', 'With or without illumination'],
    priceFrom: 'from CHF 500',
  },
  {
    title: 'Trade Show Displays',
    description: 'Complete exhibition stand solutions for your successful appearance: roll-ups, pop-up displays, banners, exhibition walls and custom booth concepts. Including transport, setup and storage.',
    href: '/en/services/trade-shows',
    features: ['Full service', 'Modular systems', 'Short delivery times'],
    priceFrom: 'from CHF 500',
  },
  {
    title: 'Art in Architecture',
    description: 'Custom art installations and artistic designs for architecture and public spaces. In collaboration with architects and artists, we realize complex visions with state-of-the-art manufacturing techniques.',
    href: '/en/services/art-in-architecture',
    features: ['CNC, laser, 3D printing', 'Experience with tenders', 'Artist network'],
    priceFrom: 'from CHF 5,000',
  },
  {
    title: 'Fine Art Prints',
    description: 'High-quality giclee art prints in gallery quality for artists, photographers and art lovers. Lightfast for over 100 years, on fine art papers from Hahnemuhle and Canson. Large formats up to 150 cm wide.',
    href: '/en/services/fine-art-prints',
    features: ['Museum quality', '100+ years lightfast', 'Editions with certificate'],
    priceFrom: 'from CHF 50',
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription} lang="en">
  <main>
    <!-- Hero Section -->
    <section class="relative py-20 md:py-32 bg-gradient-to-br from-[var(--color-primary-900)] via-[var(--color-primary-800)] to-[var(--color-primary-700)] text-white overflow-hidden">
      <div class="absolute inset-0 opacity-10" aria-hidden="true">
        <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
          <defs>
            <pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse">
              <path d="M 10 0 L 0 0 0 10" fill="none" stroke="currentColor" stroke-width="0.5"/>
            </pattern>
          </defs>
          <rect width="100" height="100" fill="url(#grid)"/>
        </svg>
      </div>

      <div class="container mx-auto px-4 max-w-6xl relative z-10">
        <div class="max-w-3xl">
          <span class="inline-block px-4 py-2 bg-white/10 rounded-full text-sm font-medium mb-6">
            Everything from One Source
          </span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
            Our Services
          </h1>
          <p class="text-xl md:text-2xl text-white/90 mb-8 leading-relaxed">
            The complete spectrum of professional signage and visual communication - from consultation to design and production to professional installation.
          </p>
          <div class="flex flex-wrap gap-4">
            <Button href="/en/contact/" variant="secondary" size="lg">
              Request Free Consultation
            </Button>
            <a href="tel:+41417800505" class="inline-flex items-center gap-2 px-6 py-3 bg-white/10 hover:bg-white/20 rounded-lg transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              +41 41 780 05 05
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Services Grid -->
    <section class="py-16 md:py-24 bg-[var(--background)]">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="grid gap-8 md:gap-12">
          {services.map((service, index) => (
            <article class="group bg-[var(--card)] rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300">
              <div class="p-8 md:p-10">
                <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
                  <div class="flex-1">
                    <div class="flex items-center gap-3 mb-4">
                      <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-[var(--color-primary-100)] text-[var(--primary)] font-bold text-lg">
                        {index + 1}
                      </span>
                      <h2 class="text-2xl md:text-3xl font-bold text-[var(--foreground)] group-hover:text-[var(--primary)] transition-colors">
                        <a href={service.href} class="hover:underline">{service.title}</a>
                      </h2>
                    </div>
                    <p class="text-[var(--foreground-secondary)] leading-relaxed mb-6">
                      {service.description}
                    </p>
                    <div class="flex flex-wrap gap-3 mb-6">
                      {service.features.map((feature) => (
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-[var(--color-primary-50)] text-[var(--color-primary-700)] rounded-full text-sm">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                          </svg>
                          {feature}
                        </span>
                      ))}
                    </div>
                  </div>
                  <div class="flex flex-col items-start md:items-end gap-4 md:min-w-[200px]">
                    <div class="text-right">
                      <span class="block text-sm text-[var(--foreground-secondary)]">Price</span>
                      <span class="text-2xl font-bold text-[var(--primary)]">{service.priceFrom}</span>
                    </div>
                    <Button href={service.href} variant="outline" size="sm">
                      Learn More
                    </Button>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Why Alpha Sign Section -->
    <section class="py-16 md:py-24 bg-[var(--background-secondary)]">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-[var(--foreground)] mb-4">
            Why Alpha Sign?
          </h2>
          <p class="text-lg text-[var(--foreground-secondary)] max-w-2xl mx-auto">
            Over 35 years of experience, Swiss quality and personal service
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-[var(--card)] rounded-xl p-6 text-center shadow-md">
            <div class="w-16 h-16 mx-auto mb-4 bg-[var(--color-primary-100)] rounded-full flex items-center justify-center">
              <span class="text-2xl font-bold text-[var(--primary)]">35+</span>
            </div>
            <h3 class="font-bold text-[var(--foreground)] mb-2">Years Experience</h3>
            <p class="text-sm text-[var(--foreground-secondary)]">Your signage partner since 1989</p>
          </div>
          <div class="bg-[var(--card)] rounded-xl p-6 text-center shadow-md">
            <div class="w-16 h-16 mx-auto mb-4 bg-[var(--color-primary-100)] rounded-full flex items-center justify-center">
              <span class="text-2xl font-bold text-[var(--primary)]">5.0</span>
            </div>
            <h3 class="font-bold text-[var(--foreground)] mb-2">Star Rating</h3>
            <p class="text-sm text-[var(--foreground-secondary)]">Highest customer satisfaction</p>
          </div>
          <div class="bg-[var(--card)] rounded-xl p-6 text-center shadow-md">
            <div class="w-16 h-16 mx-auto mb-4 bg-[var(--color-primary-100)] rounded-full flex items-center justify-center">
              <span class="text-2xl font-bold text-[var(--primary)]">2.5k</span>
            </div>
            <h3 class="font-bold text-[var(--foreground)] mb-2">Projects</h3>
            <p class="text-sm text-[var(--foreground-secondary)]">Successfully completed</p>
          </div>
          <div class="bg-[var(--card)] rounded-xl p-6 text-center shadow-md">
            <div class="w-16 h-16 mx-auto mb-4 bg-[var(--color-accent-100)] rounded-full flex items-center justify-center">
              <svg class="w-8 h-8 text-[var(--color-accent-500)]" viewBox="0 0 32 32" fill="currentColor">
                <rect x="13" y="6" width="6" height="20"/>
                <rect x="6" y="13" width="20" height="6"/>
              </svg>
            </div>
            <h3 class="font-bold text-[var(--foreground)] mb-2">Swiss Made</h3>
            <p class="text-sm text-[var(--foreground-secondary)]">100% produced in Hunenberg</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 md:py-24 bg-gradient-to-br from-[var(--color-primary-600)] to-[var(--color-primary-800)] text-white">
      <div class="container mx-auto px-4 max-w-4xl text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          Have a Project in Mind?
        </h2>
        <p class="text-xl text-white/90 mb-8">
          Contact us for a free, no-obligation consultation. We look forward to hearing from you!
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <Button href="/en/contact/" variant="secondary" size="lg">
            Request a Quote
          </Button>
          <a href="tel:+41417800505" class="inline-flex items-center gap-2 px-6 py-3 bg-white/10 hover:bg-white/20 rounded-lg transition-colors font-medium">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            +41 41 780 05 05
          </a>
        </div>
        <p class="mt-8 text-white/70 text-sm">
          Industriestrasse 15, 6331 Hunenberg | info@alphasign.ch | Mon-Fri 08:00-17:00
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
