 * Wayfinding & Signage Service Page (English)
 * SEO-optimized for Swiss B2B market
 * Comprehensive content with pricing, process, FAQ, and CTAs
 */
import ServiceLayout from '../../../layouts/ServiceLayout.astro';

const serviceData = {
  title: 'Wayfinding',
  description: 'Professional wayfinding systems in Switzerland - Directional signage, building signage and navigation systems for buildings and premises. CHF 3,000-50,000. Consultation: +41 41 780 05 05',
  heroImage: 'https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1920&q=80',
  heroImageAlt: 'Modern wayfinding system in a Swiss office building',
  serviceDescription: `Effective orientation begins with thoughtful wayfinding design. Alpha Sign AG develops and implements customized orientation systems for businesses, public buildings, hospitals, hotels and premises throughout Switzerland.

From the underground garage to the top floor, from reception to the meeting room - we guide your visitors, patients, guests and employees safely and intuitively to their destination. Our modular systems are flexibly expandable and meet the requirements for barrier-free design according to SIA 500.

**Free consultation for your wayfinding project: +41 41 780 05 05**`,
  benefits: [
    'Consistent appearance according to your corporate design',
    'Barrier-free navigation according to SIA 500 (Braille, tactile, high-contrast)',
    'Modular systems for easy adaptations and extensions',
