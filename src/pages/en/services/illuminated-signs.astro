 * Comprehensive content with pricing, process, FAQ, and CTAs
 */
import ServiceLayout from '../../../layouts/ServiceLayout.astro';

const serviceData = {
  title: 'Illuminated Signs',
  description: 'Professional illuminated signs in Switzerland - LED signage, channel letters and light boxes. Including permit consultation. CHF 2,000-25,000. Get advice: +41 41 780 05 05',
  heroImage: 'https://images.unsplash.com/photo-1557804506-669a67965ba0?auto=format&fit=crop&w=1920&q=80',
  heroImageAlt: 'Modern LED illuminated sign on commercial building in Switzerland',
  serviceDescription: `Put your business in the spotlight with professional illuminated signs from Alpha Sign AG. As an experienced Swiss provider of light advertising, we have been creating LED signs, illuminated logos, light boxes and 3D channel letters since 1989.

Our LED technology offers up to 80% energy savings compared to conventional illuminated signs and a lifespan of over 50,000 operating hours. We also guide you through the cantonal permit process - a service that many customers particularly appreciate.

**Free consultation: +41 41 780 05 05** - We advise on design, technology and permits.`,
  benefits: [
    '24/7 visibility - maximum advertising impact even in darkness',
    'Energy-efficient LED technology with up to 80% power savings',
    'Long lifespan of 50,000+ operating hours (over 15 years)',
    'Custom designs - from classic elegant to modern eye-catching',
    'Complete permit consultation and application preparation included',
    'Maintenance, repair and service from a single source',
    'Various lighting effects: continuous light, dimmable, animated',
