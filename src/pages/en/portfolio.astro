---
/**
 * Portfolio Page (English)
 * Filterable project grid showcasing Alpha Sign AG's work
 * Data is fetched from Sanity CMS with fallback to static data
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/seo/SEO.astro';
import PortfolioGrid from '../../components/sections/PortfolioGrid.astro';
import { getProjects, categories } from '../../lib/sanity-projects';

// Fetch projects from Sanity (with fallback to static data)
const projects = await getProjects();

const title = 'Portfolio | Alpha Sign AG - Our Reference Projects';
const description = 'Discover our reference projects: vehicle graphics, illuminated signs, wayfinding, car wrapping and more. Professional signage solutions from Switzerland.';
---

<BaseLayout title={title} description={description} lang="en">
  <head slot="head">
    <SEO
      title={title}
      description={description}
      keywords={[
        'Portfolio',
        'Reference Projects',
        'Vehicle Graphics',
        'Illuminated Signs',
        'Wayfinding',
        'Car Wrapping',
        'Building Signage',
        'Trade Show',
        'Alpha Sign',
        'Switzerland',
        'Zug',
      ]}
      image="/images/og/portfolio.jpg"
      imageAlt="Alpha Sign AG Portfolio - Reference Projects"
      locale="en"
    />
  </head>

  <main>
    <!-- Hero Section -->
    <section class="relative py-20 lg:py-32 bg-gradient-to-br from-primary-900 via-primary-800 to-primary-900 overflow-hidden">
      <!-- Background Pattern -->
      <div class="absolute inset-0 opacity-10" aria-hidden="true">
        <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
          <defs>
            <pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse">
              <path d="M 10 0 L 0 0 0 10" fill="none" stroke="white" stroke-width="0.5"/>
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#grid)" />
        </svg>
      </div>

      <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-3xl mx-auto text-center">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
            Our Reference Projects
          </h1>
          <p class="text-xl text-primary-100 leading-relaxed">
            Discover a selection of our successfully completed projects.
            Each project tells a story of quality, creativity, and precision.
          </p>
        </div>
      </div>

      <!-- Decorative Wave -->
      <div class="absolute bottom-0 left-0 right-0" aria-hidden="true">
        <svg class="w-full h-16 text-white dark:text-neutral-950" viewBox="0 0 1440 64" preserveAspectRatio="none">
          <path fill="currentColor" d="M0,32L48,37.3C96,43,192,53,288,53.3C384,53,480,43,576,37.3C672,32,768,32,864,37.3C960,43,1056,53,1152,53.3C1248,53,1344,43,1392,37.3L1440,32L1440,64L1392,64C1344,64,1248,64,1152,64C1056,64,960,64,864,64C768,64,672,64,576,64C480,64,384,64,288,64C192,64,96,64,48,64L0,64Z"></path>
        </svg>
      </div>
    </section>

    <!-- Portfolio Grid -->
    <PortfolioGrid
      projects={projects}
      categories={categories.en}
      lang="en"
    />

    <!-- CTA Section -->
    <section class="py-16 lg:py-24 bg-neutral-50 dark:bg-neutral-900">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-6">
            Your Project Could Be Here
          </h2>
          <p class="text-lg text-neutral-600 dark:text-neutral-400 mb-8">
            Do you have a project you would like to realize with us?
            Contact us for a no-obligation consultation.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/en/contact/"
              class="inline-flex items-center justify-center px-8 py-4 bg-primary-600 text-white font-semibold rounded-lg hover:bg-primary-700 transition-colors shadow-lg shadow-primary-600/25"
            >
              Request a Project
              <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            <a
              href="tel:+41417401040"
              class="inline-flex items-center justify-center px-8 py-4 bg-white dark:bg-neutral-800 text-neutral-900 dark:text-white font-semibold rounded-lg border-2 border-neutral-200 dark:border-neutral-700 hover:border-primary-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
            >
              <svg class="mr-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              +41 41 740 10 40
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
