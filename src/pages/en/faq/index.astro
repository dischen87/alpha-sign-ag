---
/**
 * FAQ Overview Page - English
 * Links to FAQ sections on individual service pages
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SEO from '../../../components/seo/SEO.astro';

const title = "FAQ - Frequently Asked Questions About Our Services | Alpha Sign AG";
const description = "Find answers to common questions about vehicle lettering, car wrapping, illuminated signs, wayfinding, and more. Expert guides from Alpha Sign AG.";
const canonical = "https://alphasign.ch/en/faq";

const serviceCategories = [
  {
    title: "Vehicle Lettering",
    description: "Everything about lettering and wrapping for commercial and private vehicles.",
    href: "/en/services/vehicle-lettering#faq",
    image: "https://images.unsplash.com/photo-1619642751034-765dfdf7c58e?auto=format&fit=crop&w=400&q=75",
    topics: ["Costs and Prices", "Durability", "Materials", "Removal", "Permits"]
  },
  {
    title: "Car Wrapping",
    description: "Full wraps, color changes, and paint protection film for your vehicle.",
    href: "/en/services/car-wrapping#faq",
    image: "https://images.unsplash.com/photo-1552519507-da3b142c6e3d?auto=format&fit=crop&w=400&q=75",
    topics: ["Wrapping vs. Paint", "Film Quality", "Care", "Vehicle Registration", "Costs"]
  },
  {
    title: "Illuminated Signs",
    description: "LED light advertising, illuminated letters, and lit company signs.",
    href: "/en/services/illuminated-signs#faq",
    image: "https://images.unsplash.com/photo-1557804506-669a67965ba0?auto=format&fit=crop&w=400&q=75",
    topics: ["Permits", "Costs", "Power Consumption", "Lifespan", "LED Conversion"]
  },
  {
    title: "Wayfinding",
    description: "Orientation systems, wayfinding systems, and signage for buildings.",
    href: "/en/services/wayfinding#faq",
    image: "https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=400&q=75",
    topics: ["What is Wayfinding", "Costs", "Materials", "Accessibility", "Project Duration"]
  },
  {
    title: "Building Signage",
    description: "Facade lettering, 3D letters, and storefront design.",
    href: "/en/services/building-signage#faq",
    image: "https://images.unsplash.com/photo-1497366811353-6870744d04b2?auto=format&fit=crop&w=400&q=75",
    topics: ["Materials", "Installation", "Lighting", "Permits"]
  },
  {
    title: "Trade Shows",
    description: "Trade show booths, displays, and event branding for your professional appearance.",
    href: "/en/services/trade-shows#faq",
    image: "https://images.unsplash.com/photo-1540575467063-178a50c2df87?auto=format&fit=crop&w=400&q=75",
    topics: ["Planning", "Materials", "Setup and Takedown", "Costs"]
  }
];

// FAQ Schema for the overview page
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": serviceCategories.map(service => ({
    "@type": "Question",
    "name": `Frequently Asked Questions About ${service.title}`,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": `${service.description} Topics: ${service.topics.join(", ")}. Visit our ${service.title} page for detailed answers.`
    }
  }))
};
---

<BaseLayout title={title} description={description} lang="en">
  <SEO
    title={title}
    description={description}
    canonical={canonical}
    type="website"
    keywords={["FAQ signage", "vehicle lettering questions", "sign making FAQ", "illuminated sign FAQ", "wayfinding questions"]}
  />

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <main class="max-w-6xl mx-auto px-4 py-12">
    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-600 mb-8" aria-label="Breadcrumb">
      <ol class="flex items-center space-x-2">
        <li><a href="/en" class="hover:text-blue-600">Home</a></li>
        <li>/</li>
        <li class="text-gray-900">FAQ</li>
      </ol>
    </nav>

    <header class="mb-12 text-center">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">
        Frequently Asked Questions
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Find answers to the most important questions about our services.
        Select a category to see the most common questions and detailed answers.
      </p>
    </header>

    <!-- Service Categories Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
      {serviceCategories.map((service) => (
        <a
          href={service.href}
          class="group block bg-white rounded-xl overflow-hidden shadow-sm border border-gray-200 hover:shadow-lg hover:border-blue-300 transition-all duration-300"
        >
          <div class="aspect-video overflow-hidden">
            <img
              src={service.image}
              alt={service.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
          </div>
          <div class="p-6">
            <h2 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">
              FAQ: {service.title}
            </h2>
            <p class="text-gray-600 mb-4">{service.description}</p>
            <div class="flex flex-wrap gap-2 mb-4">
              {service.topics.slice(0, 3).map((topic) => (
                <span class="text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded">
                  {topic}
                </span>
              ))}
              {service.topics.length > 3 && (
                <span class="text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded">
                  +{service.topics.length - 3} more
                </span>
              )}
            </div>
            <span class="inline-flex items-center text-blue-600 font-medium group-hover:gap-2 transition-all">
              View FAQ
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- Quick Contact -->
    <div class="bg-blue-50 rounded-xl p-8 mb-12">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div>
          <h2 class="text-2xl font-bold text-gray-900 mb-2">Your question not listed?</h2>
          <p class="text-gray-600">
            Contact us directly - we're happy to advise you personally and without obligation.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="/en/contact"
            class="inline-flex items-center justify-center px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors"
          >
            Get in Touch
          </a>
          <a
            href="tel:+41417800505"
            class="inline-flex items-center justify-center px-6 py-3 border-2 border-blue-600 text-blue-600 font-semibold rounded-lg hover:bg-blue-600 hover:text-white transition-colors"
          >
            +41 41 780 05 05
          </a>
        </div>
      </div>
    </div>

    <!-- Additional Resources -->
    <section>
      <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">More Information</h2>

      <div class="grid md:grid-cols-3 gap-6">
        <a href="/en/services" class="block bg-gray-50 rounded-lg p-6 hover:shadow-md transition-shadow text-center">
          <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">All Services</h3>
          <p class="text-gray-600 text-sm">Complete overview of our signage services.</p>
        </a>

        <a href="/en/portfolio" class="block bg-gray-50 rounded-lg p-6 hover:shadow-md transition-shadow text-center">
          <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Portfolio</h3>
          <p class="text-gray-600 text-sm">Reference projects and examples of our work.</p>
        </a>

        <a href="/en/contact" class="block bg-gray-50 rounded-lg p-6 hover:shadow-md transition-shadow text-center">
          <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Contact</h3>
          <p class="text-gray-600 text-sm">Personal consultation and individual quotes.</p>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
