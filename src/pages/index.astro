---
/**
 * German Homepage for Alpha Sign AG
 * Includes LocalBusiness schema for SEO
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Services from '../components/sections/Services.astro';
import WhyUs from '../components/sections/WhyUs.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import CTA from '../components/sections/CTA.astro';
import type { LocalBusinessSchema, BreadcrumbSchema, OrganizationSchema } from '../components/seo/SchemaOrg.astro';

// Define schemas for homepage
const localBusinessSchema: LocalBusinessSchema = {
  type: 'LocalBusiness',
  additionalType: 'ProfessionalService',
};

const organizationSchema: OrganizationSchema = {
  type: 'Organization',
};

const breadcrumbSchema: BreadcrumbSchema = {
  type: 'BreadcrumbList',
  items: [
    { name: 'Home', url: 'https://www.alphasign.ch/' },
  ],
};

// Homepage SEO keywords
const keywords = [
  'Schilder',
  'Beschriftungen',
  'Werbetechnik',
  'Leuchtreklamen',
  'Fahrzeugbeschriftung',
  'Car Wrapping',
  'Signaletik',
  'Gebäudebeschriftung',
  'Kunst am Bau',
  'Fine Art Prints',
  'Hünenberg',
  'Zug',
  'Schweiz',
  'Alpha Sign AG',
];
---

<BaseLayout
  title="Alpha Sign AG - Beschriftungen, Leuchtreklamen & Signaletik | Hünenberg, Zug"
  description="Alpha Sign AG in Hünenberg - Ihr Schweizer Partner für Fahrzeugbeschriftung, Car Wrapping, Leuchtreklamen, Signaletik, Gebäudebeschriftung und Fine Art Prints. Seit 1989. Jetzt Offerte anfragen!"
  lang="de"
  keywords={keywords}
  schema={[localBusinessSchema, organizationSchema, breadcrumbSchema]}
>
  <!-- Hero Section -->
  <Hero locale="de" />

  <!-- Testimonials Section (directly after Hero) -->
  <Testimonials locale="de" />

  <!-- Services Section -->
  <Services locale="de" />

  <!-- Why Us / USP Section -->
  <WhyUs locale="de" />

  <!-- Call to Action Section -->
  <CTA locale="de" phoneNumber="+41 41 780 05 05" />
</BaseLayout>
