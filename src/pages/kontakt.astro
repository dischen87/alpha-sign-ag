---
/**
 * German Contact Page
 * Professional contact form with company information
 * Includes comprehensive Schema.org structured data
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Input from '../components/ui/Input.astro';
import Textarea from '../components/ui/Textarea.astro';
import { useTranslations } from '../i18n/utils';
import type { LocalBusinessSchema, BreadcrumbSchema, ContactPointSchema } from '../components/seo/SchemaOrg.astro';

const t = useTranslations('de');

// Company Information
const company = {
  name: 'Alpha Sign AG',
  address: {
    street: 'Bösch 104',
    postalCode: '6331',
    city: 'Huenenberg',
    country: 'Schweiz',
  },
  phone: '+41 41 780 05 05',
  email: 'info@alphasign.ch',
  hours: 'Mo-Fr: 07:30 - 12:00, 13:15 - 17:00',
};

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${company.address.street}, ${company.address.postalCode} ${company.address.city}, ${company.address.country}`
)}`;

// Schema definitions
const localBusinessSchema: LocalBusinessSchema = {
  type: 'LocalBusiness',
  additionalType: 'SignShop',
};

const breadcrumbSchema: BreadcrumbSchema = {
  type: 'BreadcrumbList',
  items: [
    { name: 'Home', url: 'https://www.alphasign.ch/' },
    { name: 'Kontakt', url: 'https://www.alphasign.ch/kontakt' },
  ],
};

const contactPointSchema: ContactPointSchema = {
  type: 'ContactPoint',
  telephone: '+41 41 780 05 05',
  email: 'info@alphasign.ch',
  contactType: 'customer service',
  areaServed: ['CH', 'DE', 'AT'],
  availableLanguage: ['German', 'English', 'French', 'Italian'],
};
---

<BaseLayout
  title="Kontakt - Alpha Sign AG"
  description="Kontaktieren Sie Alpha Sign AG in Huenenberg fuer ein unverbindliches Angebot. Telefon, E-Mail oder Kontaktformular - wir freuen uns auf Ihre Anfrage."
  lang="de"
  schema={[localBusinessSchema, breadcrumbSchema, contactPointSchema]}
>
  <!-- Hero Section -->
  <section class="relative py-20 lg:py-28 bg-primary-950 overflow-hidden">
    <div class="absolute inset-0 opacity-5 bg-[url('data:image/svg+xml;base64,')]" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-4 py-1.5 mb-4 text-sm font-semibold text-primary-300 bg-primary-900 rounded-full">
        Kontakt
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 tracking-tight">
        Sprechen Sie mit uns
      </h1>
      <p class="text-lg sm:text-xl text-primary-200/80 max-w-2xl mx-auto leading-relaxed">
        Wir freuen uns auf Ihre Anfrage und beraten Sie gerne unverbindlich zu Ihrem Projekt.
      </p>
    </div>
  </section>

  <!-- Contact Content -->
  <section class="py-16 lg:py-24 bg-background dark:bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">

        <!-- Contact Form -->
        <div class="order-2 lg:order-1">
          <div class="bg-card border border-border rounded-[var(--radius)] p-8 lg:p-10 shadow-sm dark:border-border">
            <h2 class="text-2xl font-bold text-foreground mb-2">Kontaktformular</h2>
            <p class="text-muted-foreground mb-8">Fuellen Sie das Formular aus und wir melden uns innerhalb von 24 Stunden bei Ihnen.</p>

            <form action="/api/contact" method="POST" class="space-y-6">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <Input
                  name="firstName"
                  label="Vorname"
                  placeholder="Max"
                  required
                  autocomplete="given-name"
                />
                <Input
                  name="lastName"
                  label="Nachname"
                  placeholder="Mustermann"
                  required
                  autocomplete="family-name"
                />
              </div>

              <Input
                type="email"
                name="email"
                label="E-Mail"
                placeholder="max@beispiel.ch"
                required
                autocomplete="email"
              />

              <Input
                type="tel"
                name="phone"
                label="Telefon"
                placeholder="+41 79 123 45 67"
                autocomplete="tel"
                hint="Optional, aber hilfreich fuer Rueckfragen"
              />

              <Input
                name="company"
                label="Firma"
                placeholder="Firma AG"
                autocomplete="organization"
              />

              <div>
                <label for="service" class="block text-sm font-semibold text-foreground mb-1.5">
                  Interessiert an
                </label>
                <select
                  name="service"
                  id="service"
                  class="w-full px-4 py-3.5 bg-background border-2 border-border rounded-[var(--radius)] text-foreground text-base transition-all duration-200 ease-out hover:border-muted-foreground/50 focus:outline-none focus:border-primary focus:ring-4 focus:ring-primary/10 dark:bg-input dark:border-border dark:hover:border-muted-foreground/30 min-h-[52px]"
                >
                  <option value="">Bitte waehlen...</option>
                  <option value="fahrzeugbeschriftung">Fahrzeugbeschriftung</option>
                  <option value="leuchtreklame">Leuchtreklame</option>
                  <option value="signaletik">Signaletik / Wegweiser</option>
                  <option value="car-wrapping">Car Wrapping</option>
                  <option value="gebaeudebeschriftung">Gebaeudebeschriftung</option>
                  <option value="messeauftritte">Messeauftritte</option>
                  <option value="kunst-am-bau">Kunst am Bau</option>
                  <option value="fine-art-prints">Fine Art Prints</option>
                  <option value="andere">Andere Dienstleistung</option>
                </select>
              </div>

              <Textarea
                name="message"
                label="Nachricht"
                placeholder="Beschreiben Sie Ihr Projekt oder Ihre Anfrage..."
                rows={5}
                required
                maxlength={2000}
              />

              <div class="flex items-start gap-3">
                <input
                  type="checkbox"
                  name="privacy"
                  id="privacy"
                  required
                  class="mt-1 h-5 w-5 rounded border-2 border-border text-primary focus:ring-2 focus:ring-primary/20 focus:ring-offset-0 dark:border-border dark:bg-input cursor-pointer"
                />
                <label for="privacy" class="text-sm text-muted-foreground leading-relaxed cursor-pointer">
                  Ich habe die <a href="/datenschutz" class="text-primary font-medium hover:underline">Datenschutzerklaerung</a> gelesen und bin mit der Verarbeitung meiner Daten einverstanden.
                </label>
              </div>

              <button
                type="submit"
                class="w-full inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-primary-foreground bg-primary rounded-[var(--radius)] hover:bg-primary/90 transition-all duration-200 shadow-sm hover:shadow-md focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 min-h-[56px] btn-press"
              >
                Anfrage senden
                <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </button>
            </form>
          </div>
        </div>

        <!-- Contact Information -->
        <div class="order-1 lg:order-2">
          <h2 class="text-2xl font-bold text-foreground mb-6">Kontaktinformationen</h2>

          <div class="space-y-8">
            <!-- Address -->
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-12 h-12 rounded-[var(--radius)] bg-primary/10 flex items-center justify-center">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-foreground mb-1">Adresse</h3>
                <address class="not-italic text-muted-foreground">
                  {company.name}<br />
                  {company.address.street}<br />
                  {company.address.postalCode} {company.address.city}<br />
                  {company.address.country}
                </address>
                <a
                  href={mapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 mt-2 text-sm font-medium text-primary hover:underline"
                >
                  Auf Google Maps anzeigen
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </div>
            </div>

            <!-- Phone -->
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-12 h-12 rounded-[var(--radius)] bg-primary/10 flex items-center justify-center">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-foreground mb-1">Telefon</h3>
                <a
                  href={`tel:${company.phone.replace(/\s/g, '')}`}
                  class="text-muted-foreground hover:text-primary transition-colors"
                >
                  {company.phone}
                </a>
              </div>
            </div>

            <!-- Email -->
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-12 h-12 rounded-[var(--radius)] bg-primary/10 flex items-center justify-center">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-foreground mb-1">E-Mail</h3>
                <a
                  href={`mailto:${company.email}`}
                  class="text-muted-foreground hover:text-primary transition-colors"
                >
                  {company.email}
                </a>
              </div>
            </div>

            <!-- Hours -->
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-12 h-12 rounded-[var(--radius)] bg-primary/10 flex items-center justify-center">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-foreground mb-1">Oeffnungszeiten</h3>
                <p class="text-muted-foreground">{company.hours}</p>
              </div>
            </div>
          </div>

          <!-- Additional Info Card -->
          <div class="mt-10 p-6 bg-primary/5 border border-primary/10 rounded-[var(--radius)]">
            <h3 class="font-semibold text-foreground mb-2">Schnelle Antwort garantiert</h3>
            <p class="text-sm text-muted-foreground">
              Wir antworten in der Regel innerhalb von 24 Stunden auf Ihre Anfrage. Bei dringenden Anliegen erreichen Sie uns auch telefonisch.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Map Section -->
  <section class="h-96 bg-muted">
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2715.5!2d8.4267!3d47.1756!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNDfCsDEwJzMyLjIiTiA4wrAyNSczNi4xIkU!5e0!3m2!1sde!2sch!4v1234567890"
      width="100%"
      height="100%"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title="Alpha Sign AG Standort"
    ></iframe>
  </section>
</BaseLayout>
